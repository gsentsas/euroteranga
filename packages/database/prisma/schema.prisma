// EURO TERANGA — database schema.
//
// Business tables are introduced by the pull requests that own each domain.
// Tables and columns use snake_case; all timestamps are timestamptz (UTC).
// The connection URL comes from prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Authentication realm. Not a business role: STAFF is not yet DIRECTOR etc.
enum AuthRealm {
  CUSTOMER
  STAFF
  CREW

  @@map("auth_realm")
}

enum AuthIdentityStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("auth_identity_status")
}

enum AuthChallengeType {
  MFA_LOGIN
  MFA_ENROLLMENT

  @@map("auth_challenge_type")
}

enum AuthSessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET
  ADMIN_ACTION

  @@map("auth_session_revocation_reason")
}

enum CheckpointType {
  BORDER
  FERRY_TERMINAL
  PORT
  TECHNICAL

  @@map("checkpoint_type")
}

enum SeatMapVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("seat_map_version_status")
}

/// Physical kind of a seat-map cell. An absent coordinate is an empty area.
enum SeatMapCellKind {
  SEAT
  AISLE
  DRIVER
  DOOR
  TOILET
  STAIRS
  OTHER

  @@map("seat_map_cell_kind")
}

enum TripStatus {
  DRAFT
  SCHEDULED
  CANCELLED

  @@map("trip_status")
}

enum VehicleStatus {
  PLANNED
  ACTIVE
  OUT_OF_SERVICE
  RETIRED

  @@map("vehicle_status")
}

enum RouteVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("route_version_status")
}

/// An identity able to authenticate in exactly one realm. It is not a
/// customer, passenger, staff profile or crew member: those business objects
/// will reference it later and stay independent.
model AuthIdentity {
  id              String             @id @default(uuid(7)) @db.Uuid
  realm           AuthRealm
  /// Address as entered (display only).
  email           String             @db.VarChar(254)
  /// trim + lowercase; used for lookup and uniqueness (docs/security/authentication.md).
  normalizedEmail String             @map("normalized_email") @db.VarChar(254)
  status          AuthIdentityStatus
  emailVerifiedAt DateTime?          @map("email_verified_at") @db.Timestamptz(3)
  /// Incremented to invalidate every session at once (password change/reset...).
  authVersion     Int                @default(1) @map("auth_version")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordCredential      PasswordCredential?
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  challenges              AuthChallenge[]
  mfaTotpCredential       MfaTotpCredential?
  mfaRecoveryCodes        MfaRecoveryCode[]

  // PR-03 authorization, audit and STAFF provisioning.
  roleAssignments             AuthorizationRoleAssignment[] @relation("RoleAssignmentIdentity")
  roleGrantsIssued            AuthorizationRoleAssignment[] @relation("RoleAssignmentGrantedBy")
  roleRevocationsIssued       AuthorizationRoleAssignment[] @relation("RoleAssignmentRevokedBy")
  auditEvents                 AuditEvent[]                  @relation("AuditActor")
  staffInvitations            StaffInvitation[]             @relation("StaffInvitationIdentity")
  staffInvitationsCreated     StaffInvitation[]             @relation("StaffInvitationCreatedBy")
  staffEnrollmentGrant        StaffEnrollmentGrant?         @relation("StaffEnrollmentIdentity")
  staffEnrollmentGrantsIssued StaffEnrollmentGrant[]        @relation("StaffEnrollmentIssuedBy")

  // The same address may exist in two realms as two unrelated identities.
  @@unique([realm, normalizedEmail])
  @@map("auth_identity")
}

model PasswordCredential {
  identityId   String   @id @map("identity_id") @db.Uuid
  /// PHC-encoded Argon2id hash (algorithm and parameters included).
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("password_credential")
}

/// Opaque, revocable browser session. Only SHA-256(token) is stored.
model AuthSession {
  id                String                       @id @default(uuid(7)) @db.Uuid
  identityId        String                       @map("identity_id") @db.Uuid
  tokenHash         Bytes                        @unique @map("token_hash")
  /// Copy of AuthIdentity.authVersion at creation; a mismatch invalidates the session.
  authVersion       Int                          @map("auth_version")
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime                     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime                     @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime                     @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?                    @map("revoked_at") @db.Timestamptz(3)
  revocationReason  AuthSessionRevocationReason? @map("revocation_reason")

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([absoluteExpiresAt])
  @@map("auth_session")
}

/// Single-use email verification token (hash only). It carries the password
/// hash chosen at registration, applied only when the token is verified.
model EmailVerificationToken {
  id                  String    @id @default(uuid(7)) @db.Uuid
  identityId          String    @map("identity_id") @db.Uuid
  tokenHash           Bytes     @unique @map("token_hash")
  pendingPasswordHash String?   @map("pending_password_hash")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt       DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
  @@map("email_verification_token")
}

/// Single-use password reset token (hash only).
model PasswordResetToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  identityId    String    @map("identity_id") @db.Uuid
  tokenHash     Bytes     @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

/// Short-lived, attempt-limited step between password and second factor.
model AuthChallenge {
  id         String            @id @default(uuid(7)) @db.Uuid
  identityId String            @map("identity_id") @db.Uuid
  type       AuthChallengeType
  tokenHash  Bytes             @unique @map("token_hash")
  attempts   Int               @default(0)
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?         @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
  @@map("auth_challenge")
}

/// TOTP secret, encrypted with AES-256-GCM (key outside the database).
/// enabledAt is null while enrollment is pending.
model MfaTotpCredential {
  identityId       String    @id @map("identity_id") @db.Uuid
  /// Ciphertext followed by the 16-byte GCM authentication tag.
  secretCiphertext Bytes     @map("secret_ciphertext")
  secretNonce      Bytes     @map("secret_nonce")
  keyVersion       Int       @map("key_version")
  enabledAt        DateTime? @map("enabled_at") @db.Timestamptz(3)
  /// Highest accepted 30-second time step; codes at or below it are replays.
  lastAcceptedStep BigInt?   @map("last_accepted_step")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("mfa_totp_credential")
}

/// Single-use recovery code (SHA-256 of a high-entropy code; shown once).
model MfaRecoveryCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  identityId String    @map("identity_id") @db.Uuid
  codeHash   Bytes     @unique @map("code_hash")
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("mfa_recovery_code")
}

/// Fixed-window rate-limit counter. The key is an HMAC of the action and of
/// the limited signal (IP, identity hint): no raw email or IP is stored.
model AuthRateLimitBucket {
  key         Bytes
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  action      String   @db.VarChar(64)
  count       Int
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("auth_rate_limit_bucket")
}

/// Atomic permission enforced by the API. The catalogue is seeded by
/// migrations (single source of truth) and referenced by stable keys.
model AuthorizationPermission {
  key         String   @id @db.VarChar(96)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles AuthorizationRolePermission[]

  @@map("authorization_permission")
}

/// Named set of permissions, valid in exactly one realm. System roles are
/// seeded by migrations and read-only through the API in PR-03.
model AuthorizationRole {
  key         String    @id @db.VarChar(64)
  name        String    @db.VarChar(96)
  description String    @db.VarChar(255)
  /// Realm of the identities that may hold this role (enforced by a trigger).
  realm       AuthRealm
  /// Granting, revoking, or acting on holders of a privileged role requires
  /// the privileged.manage permission.
  privileged  Boolean   @default(false)
  system      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions AuthorizationRolePermission[]
  assignments AuthorizationRoleAssignment[]

  @@map("authorization_role")
}

model AuthorizationRolePermission {
  roleKey       String @map("role_key") @db.VarChar(64)
  permissionKey String @map("permission_key") @db.VarChar(96)

  role       AuthorizationRole       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission AuthorizationPermission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleKey, permissionKey])
  @@map("authorization_role_permission")
}

/// Revocable role grant. History is never overwritten or deleted: revocation
/// closes the row and records who did it and why.
model AuthorizationRoleAssignment {
  id                  String    @id @default(uuid(7)) @db.Uuid
  identityId          String    @map("identity_id") @db.Uuid
  roleKey             String    @map("role_key") @db.VarChar(64)
  grantedByIdentityId String?   @map("granted_by_identity_id") @db.Uuid
  grantedAt           DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  grantReason         String?   @map("grant_reason") @db.VarChar(255)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByIdentityId String?   @map("revoked_by_identity_id") @db.Uuid
  revocationReason    String?   @map("revocation_reason") @db.VarChar(255)

  identity  AuthIdentity      @relation("RoleAssignmentIdentity", fields: [identityId], references: [id], onDelete: Restrict)
  role      AuthorizationRole @relation(fields: [roleKey], references: [key], onDelete: Restrict)
  grantedBy AuthIdentity?     @relation("RoleAssignmentGrantedBy", fields: [grantedByIdentityId], references: [id], onDelete: Restrict)
  revokedBy AuthIdentity?     @relation("RoleAssignmentRevokedBy", fields: [revokedByIdentityId], references: [id], onDelete: Restrict)

  @@index([identityId, revokedAt])
  @@index([roleKey, revokedAt])
  @@map("authorization_role_assignment")
}

/// Append-only audit trail of privileged actions (database triggers reject
/// UPDATE, DELETE and TRUNCATE). Values are redacted before insertion.
model AuditEvent {
  id              String     @id @default(uuid(7)) @db.Uuid
  occurredAt      DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Null for system actors (e.g. the bootstrap CLI, invitation acceptance).
  actorIdentityId String?    @map("actor_identity_id") @db.Uuid
  actorRealm      AuthRealm? @map("actor_realm")
  action          String     @db.VarChar(96)
  resourceType    String     @map("resource_type") @db.VarChar(64)
  resourceId      String?    @map("resource_id") @db.VarChar(128)
  sessionId       String?    @map("session_id") @db.Uuid
  requestId       String?    @map("request_id") @db.VarChar(128)
  before          Json?
  after           Json?
  metadata        Json?

  actor AuthIdentity? @relation("AuditActor", fields: [actorIdentityId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([actorIdentityId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@map("audit_event")
}

/// Single-use, hash-only invitation through which an administrator provisions
/// a STAFF identity (there is no public staff registration).
model StaffInvitation {
  id                  String    @id @default(uuid(7)) @db.Uuid
  identityId          String    @map("identity_id") @db.Uuid
  tokenHash           Bytes     @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt       DateTime? @map("invalidated_at") @db.Timestamptz(3)
  /// Null when created by the bootstrap CLI.
  createdByIdentityId String?   @map("created_by_identity_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  identity  AuthIdentity  @relation("StaffInvitationIdentity", fields: [identityId], references: [id], onDelete: Cascade)
  createdBy AuthIdentity? @relation("StaffInvitationCreatedBy", fields: [createdByIdentityId], references: [id], onDelete: Restrict)

  @@index([identityId])
  @@index([expiresAt])
  @@map("staff_invitation")
}

/// Explicit, expiring, single-use authorization for a STAFF identity to set
/// up its first TOTP. A correct password alone never allows enrollment.
model StaffEnrollmentGrant {
  identityId         String    @id @map("identity_id") @db.Uuid
  issuedByIdentityId String?   @map("issued_by_identity_id") @db.Uuid
  issuedAt           DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz(3)

  identity AuthIdentity  @relation("StaffEnrollmentIdentity", fields: [identityId], references: [id], onDelete: Cascade)
  issuedBy AuthIdentity? @relation("StaffEnrollmentIssuedBy", fields: [issuedByIdentityId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("staff_enrollment_grant")
}

/// ISO country catalogue used by the transport network. Countries are
/// deactivated rather than physically deleted through the API.
model Country {
  id        String   @id @default(uuid(7)) @db.Uuid
  iso2      String   @unique @db.VarChar(2)
  iso3      String   @unique @db.VarChar(3)
  name      String   @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stops       Stop[]
  checkpoints Checkpoint[]
  vehicles    Vehicle[]

  @@index([active, id])
  @@map("country")
}

/// A passenger-facing point at which boarding or alighting may be allowed.
model Stop {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(160)
  countryId String   @map("country_id") @db.Uuid
  locality  String   @db.VarChar(128)
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  timezone  String   @db.VarChar(64)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  country   Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)
  waypoints RouteWaypoint[]

  @@index([countryId])
  @@index([active, id])
  @@map("stop")
}

/// An operational network point. Regulatory and customs rules deliberately
/// do not live on this record.
model Checkpoint {
  id        String         @id @default(uuid(7)) @db.Uuid
  code      String         @unique @db.VarChar(32)
  name      String         @db.VarChar(160)
  countryId String         @map("country_id") @db.Uuid
  type      CheckpointType
  locality  String         @db.VarChar(128)
  latitude  Decimal        @db.Decimal(9, 6)
  longitude Decimal        @db.Decimal(9, 6)
  timezone  String         @db.VarChar(64)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  country   Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)
  waypoints RouteWaypoint[]

  @@index([countryId])
  @@index([type])
  @@index([active, id])
  @@map("checkpoint")
}

/// Stable commercial route identity. Its geography belongs to versions.
model Route {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions RouteVersion[]

  @@index([active, id])
  @@map("route")
}

/// Ordered, immutable-once-published definition of a commercial route.
/// Partial unique indexes and lifecycle triggers live in the PR-04 migration.
model RouteVersion {
  id          String             @id @default(uuid(7)) @db.Uuid
  routeId     String             @map("route_id") @db.Uuid
  version     Int
  status      RouteVersionStatus @default(DRAFT)
  publishedAt DateTime?          @map("published_at") @db.Timestamptz(3)
  retiredAt   DateTime?          @map("retired_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  route     Route           @relation(fields: [routeId], references: [id], onDelete: Restrict)
  waypoints RouteWaypoint[]
  trips     Trip[]

  @@unique([routeId, version])
  @@index([status])
  @@map("route_version")
}

/// One position in a route version. Exactly one of stop/checkpoint is set;
/// the database also forbids passenger activity at checkpoint waypoints.
model RouteWaypoint {
  id               String  @id @default(uuid(7)) @db.Uuid
  routeVersionId   String  @map("route_version_id") @db.Uuid
  sequence         Int
  stopId           String? @map("stop_id") @db.Uuid
  checkpointId     String? @map("checkpoint_id") @db.Uuid
  boardingAllowed  Boolean @default(false) @map("boarding_allowed")
  alightingAllowed Boolean @default(false) @map("alighting_allowed")

  routeVersion RouteVersion         @relation(fields: [routeVersionId], references: [id], onDelete: Restrict)
  stop         Stop?                @relation(fields: [stopId], references: [id], onDelete: Restrict)
  checkpoint   Checkpoint?          @relation(fields: [checkpointId], references: [id], onDelete: Restrict)
  timings      TripWaypointTiming[]

  @@unique([routeVersionId, sequence])
  @@index([stopId])
  @@index([checkpointId])
  @@map("route_waypoint")
}

/// A vehicle operated by EURO TERANGA (PR-05 fleet core). Capacity, seat
/// maps, maintenance, documents and assignments belong to later domains.
/// The lifecycle (creation as PLANNED, allowed transitions, RETIRED terminal,
/// no physical deletion) is enforced by triggers in the PR-05 migration.
model Vehicle {
  id                    String        @id @default(uuid(7)) @db.Uuid
  code                  String        @unique @db.VarChar(32)
  /// Application-level shape check only (17 characters, no I/O/Q).
  vin                   String?       @unique @db.VarChar(17)
  registrationPlate     String?       @map("registration_plate") @db.VarChar(16)
  registrationCountryId String?       @map("registration_country_id") @db.Uuid
  manufacturer          String        @db.VarChar(80)
  model                 String        @db.VarChar(80)
  modelYear             Int?          @map("model_year")
  status                VehicleStatus @default(PLANNED)
  statusChangedAt       DateTime?     @map("status_changed_at") @db.Timestamptz(3)
  retiredAt             DateTime?     @map("retired_at") @db.Timestamptz(3)
  /// Physical seat map currently configured (a published version).
  seatMapVersionId      String?       @map("seat_map_version_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  registrationCountry Country?        @relation(fields: [registrationCountryId], references: [id], onDelete: Restrict)
  seatMapVersion      SeatMapVersion? @relation(fields: [seatMapVersionId], references: [id], onDelete: Restrict)
  trips               Trip[]

  @@unique([registrationCountryId, registrationPlate])
  @@index([status, id])
  @@index([seatMapVersionId])
  @@map("vehicle")
}

/// One planned occurrence of a published (historical) route version (PR-06).
/// Seats, prices, bookings, crew and actual times belong to later domains.
/// The lifecycle, the frozen timetable and the scheduling validation are
/// enforced by triggers in the PR-06 migration.
model Trip {
  id                 String     @id @default(uuid(7)) @db.Uuid
  /// Public, immutable reference (e.g. ET-TEST-2030-0001 in tests).
  reference          String     @unique @db.VarChar(32)
  routeVersionId     String     @map("route_version_id") @db.Uuid
  vehicleId          String?    @map("vehicle_id") @db.Uuid
  /// Historical seat map of this trip; frozen once SCHEDULED.
  seatMapVersionId   String?    @map("seat_map_version_id") @db.Uuid
  status             TripStatus @default(DRAFT)
  /// Departure of the first waypoint (UTC), copied from the timetable.
  plannedDepartureAt DateTime?  @map("planned_departure_at") @db.Timestamptz(3)
  /// Arrival at the last waypoint (UTC), copied from the timetable.
  plannedArrivalAt   DateTime?  @map("planned_arrival_at") @db.Timestamptz(3)
  scheduledAt        DateTime?  @map("scheduled_at") @db.Timestamptz(3)
  cancelledAt        DateTime?  @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  routeVersion   RouteVersion         @relation(fields: [routeVersionId], references: [id], onDelete: Restrict)
  vehicle        Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  seatMapVersion SeatMapVersion?      @relation(fields: [seatMapVersionId], references: [id], onDelete: Restrict)
  timings        TripWaypointTiming[]

  @@index([status, id])
  @@index([routeVersionId, id])
  @@index([plannedDepartureAt, id])
  @@index([vehicleId])
  @@index([seatMapVersionId])
  @@map("trip")
}

/// Planned time at one waypoint of the trip's route version (UTC). Editable
/// only while the trip is DRAFT; frozen once SCHEDULED or CANCELLED.
model TripWaypointTiming {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tripId             String    @map("trip_id") @db.Uuid
  routeWaypointId    String    @map("route_waypoint_id") @db.Uuid
  sequence           Int
  plannedArrivalAt   DateTime? @map("planned_arrival_at") @db.Timestamptz(3)
  plannedDepartureAt DateTime? @map("planned_departure_at") @db.Timestamptz(3)

  trip          Trip          @relation(fields: [tripId], references: [id], onDelete: Restrict)
  routeWaypoint RouteWaypoint @relation(fields: [routeWaypointId], references: [id], onDelete: Restrict)

  @@unique([tripId, sequence])
  @@unique([tripId, routeWaypointId])
  @@index([routeWaypointId])
  @@map("trip_waypoint_timing")
}

/// Stable identity of a seat-map model (PR-07). Its physical layout belongs
/// to numbered versions. Deactivation does not affect published versions.
model SeatMap {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions SeatMapVersion[]

  @@index([active, id])
  @@map("seat_map")
}

/// Numbered physical layout, immutable once published. Partial unique indexes
/// and lifecycle triggers live in the PR-07 migration.
model SeatMapVersion {
  id          String               @id @default(uuid(7)) @db.Uuid
  seatMapId   String               @map("seat_map_id") @db.Uuid
  version     Int
  status      SeatMapVersionStatus @default(DRAFT)
  publishedAt DateTime?            @map("published_at") @db.Timestamptz(3)
  retiredAt   DateTime?            @map("retired_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  seatMap  SeatMap       @relation(fields: [seatMapId], references: [id], onDelete: Restrict)
  cells    SeatMapCell[]
  vehicles Vehicle[]
  trips    Trip[]

  @@unique([seatMapId, version])
  @@index([status])
  @@map("seat_map_version")
}

/// One physical position of a version. Capacity = number of SEAT cells; it is
/// always computed, never stored.
model SeatMapCell {
  id               String          @id @default(uuid(7)) @db.Uuid
  seatMapVersionId String          @map("seat_map_version_id") @db.Uuid
  deck             Int
  row              Int             @map("row_number")
  column           Int             @map("column_number")
  kind             SeatMapCellKind
  seatLabel        String?         @map("seat_label") @db.VarChar(8)

  seatMapVersion SeatMapVersion @relation(fields: [seatMapVersionId], references: [id], onDelete: Restrict)

  @@unique([seatMapVersionId, deck, row, column])
  @@unique([seatMapVersionId, seatLabel])
  @@index([seatMapVersionId, kind])
  @@map("seat_map_cell")
}
