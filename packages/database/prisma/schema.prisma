// EURO TERANGA — database schema.
//
// Business tables are introduced by the pull requests that own each domain.
// Tables and columns use snake_case; all timestamps are timestamptz (UTC).
// The connection URL comes from prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Authentication realm. Not a business role: STAFF is not yet DIRECTOR etc.
enum AuthRealm {
  CUSTOMER
  STAFF
  CREW

  @@map("auth_realm")
}

enum AuthIdentityStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("auth_identity_status")
}

enum AuthChallengeType {
  MFA_LOGIN
  MFA_ENROLLMENT

  @@map("auth_challenge_type")
}

enum AuthSessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET
  ADMIN_ACTION

  @@map("auth_session_revocation_reason")
}

enum CheckpointType {
  BORDER
  FERRY_TERMINAL
  PORT
  TECHNICAL

  @@map("checkpoint_type")
}

/// Operational purpose of a checkpoint on the Europe–Africa corridor.
/// This is descriptive only and carries no driver-hours or legal conclusion.
enum TerangaStopKind {
  BREAK
  MEAL
  SHOWER
  REST
  OVERNIGHT
  FUEL
  BORDER
  FERRY
  TECHNICAL

  @@map("teranga_stop_kind")
}

/// Services that OPS has explicitly verified at a Teranga Stop.
enum TerangaFacility {
  RESTROOM
  SHOWER
  FOOD
  SECURE_PARKING
  FUEL

  @@map("teranga_facility")
}

enum FareTableVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("fare_table_version_status")
}

enum SeatMapVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("seat_map_version_status")
}

/// Physical kind of a seat-map cell. An absent coordinate is an empty area.
enum SeatMapCellKind {
  SEAT
  AISLE
  DRIVER
  DOOR
  TOILET
  STAIRS
  OTHER

  @@map("seat_map_cell_kind")
}

enum TripStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("trip_status")
}

/// Maturity of the internal operational cost plan. LOCKED is terminal.
enum TripCostStatus {
  DRAFT
  ESTIMATED
  LOCKED

  @@map("trip_cost_status")
}

/// Strict, traveller-independent classification of one planned trip cost.
enum TripCostCategory {
  FUEL
  TOLLS
  FERRY
  BORDER_FEES
  PERMITS
  DRIVERS
  ACCOMMODATION
  MEALS_ALLOWANCES
  MAINTENANCE
  INSURANCE
  CLEANING_PREPARATION
  PARKING
  STOP_COST
  SUPPORT_VEHICLE
  CONTINGENCY
  OTHER

  @@map("trip_cost_category")
}

enum VehicleStatus {
  PLANNED
  ACTIVE
  OUT_OF_SERVICE
  RETIRED

  @@map("vehicle_status")
}

/// Operational purpose. CARGO_SUPPORT vehicles are not passenger-facing buses.
enum VehicleRole {
  PASSENGER_COACH
  CARGO_SUPPORT
  MIXED

  @@map("vehicle_role")
}

/// On-board equipment of a vehicle (UI-PUBLIC-2), shown on the public website.
enum VehicleAmenity {
  AIR_CONDITIONING
  RECLINING_SEATS
  USB_CHARGING
  WIFI
  TOILET
  ENTERTAINMENT
  WHEELCHAIR_ACCESS

  @@map("vehicle_amenity")
}

/// Optional traveller-facing classification of a vehicle gallery image.
enum VehicleMediaKind {
  EXTERIOR
  INTERIOR
  SEATS
  LUGGAGE_HOLD
  EQUIPMENT
  CABIN
  OTHER

  @@map("vehicle_media_kind")
}

/// PR-19: the maximum tracking precision that may leave the authenticated
/// operational boundary. GPS_RECEIVED never implies GPS_PUBLIC.
enum TrackingVisibility {
  HIDDEN
  CHECKPOINT_ONLY
  APPROXIMATE
  PRECISE

  @@map("tracking_visibility")
}

enum TrackingObservationSource {
  GPS
  CHECKPOINT
  CREW
  OPS
  SYSTEM

  @@map("tracking_observation_source")
}

enum TrackingProviderStatus {
  UP
  DEGRADED
  STALE
  UNAVAILABLE

  @@map("tracking_provider_status")
}

/// PR-20: operational border workflow only. These events never express a
/// legal/customs decision or permission to enter a country.
enum BorderEventType {
  ARRIVED
  CONTROL_STARTED
  CONTROL_COMPLETED
  DEPARTED

  @@map("border_event_type")
}

enum BorderEventSource {
  STAFF
  CREW

  @@map("border_event_source")
}

/// PR-21: operational incident categories. CUSTOMS/POLICE/BORDER are factual
/// operational classifications only and never express a legal decision.
enum IncidentType {
  BREAKDOWN
  ACCIDENT
  DELAY
  BORDER
  CUSTOMS
  POLICE
  PASSENGER
  HEALTH
  BAGGAGE
  SECURITY
  WEATHER
  FERRY
  OTHER

  @@map("incident_type")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("incident_severity")
}

enum IncidentStatus {
  OPEN
  ASSESSING
  ACTION_REQUIRED
  MITIGATING
  RESOLVED
  CLOSED

  @@map("incident_status")
}

enum IncidentSource {
  STAFF
  CREW

  @@map("incident_source")
}

enum IncidentActionType {
  NOTE
  ACTION_PLAN
  MITIGATION
  PASSENGERS_INFORMED
  POSTMORTEM

  @@map("incident_action_type")
}

/// PR-22: operational finance entries only, not a general ledger.
enum FinanceRevenueType {
  BAGGAGE
  OPTION
  OTHER

  @@map("finance_revenue_type")
}

enum FinanceExpenseType {
  FUEL
  FERRY
  TOLL
  CREW
  HOTEL
  MAINTENANCE
  BORDER
  INSURANCE
  OTHER

  @@map("finance_expense_type")
}

enum FinanceEntryStatus {
  ACTIVE
  VOIDED

  @@map("finance_entry_status")
}

/// PR-10: payment service providers. SANDBOX is local and test-only: it calls
/// no external service and is refused in staging and production. PAY-HUB-1
/// declares the future providers; none has an adapter or a configuration yet.
enum PaymentProvider {
  SANDBOX
  STRIPE
  PAYPAL
  PAYDUNYA
  PAYTECH
  WAVE
  ORANGE_MONEY
  CMI
  CHARIPAY
  MOOSYL
  MANUAL_BANK_TRANSFER
  CASH

  @@map("payment_provider")
}

/// PAY-HUB-1: the customer-facing means of payment. This is deliberately
/// separate from PaymentProvider: Wave may be routed directly or through an
/// aggregator without changing the method chosen by the customer.
enum PaymentMethod {
  CARD
  CARD_CB
  CARD_VISA
  CARD_MASTERCARD
  CARD_AMEX
  APPLE_PAY
  GOOGLE_PAY
  PAYPAL
  SEPA_CREDIT_TRANSFER
  SEPA_DIRECT_DEBIT
  BIZUM
  WERO
  KLARNA
  ALMA
  WAVE_SN
  ORANGE_MONEY_SN
  FREE_MONEY_SN
  EXPRESSO_SN
  WIZALL_SN
  DJAMO_SN
  MAROCPAY
  CMI_CARD
  MOROCCO_CASH_AGENCY
  BANKILY_MR
  MASRVI_MR
  SEDAD_MR
  BIMBANK_MR
  CLICK_MR
  BCI_PAY_MR
  BANK_TRANSFER
  CASH_AT_AGENCY

  @@map("payment_method")
}

enum PaymentFxSource {
  FX_IDENTITY
  FX_SYNTHETIC_CI
  FX_MANUAL_OPS
  FX_PROVIDER
  FX_EXTERNAL_SERVICE

  @@map("payment_fx_source")
}

/// PR-10: lifecycle of one payment attempt. PENDING -> SUCCEEDED | FAILED |
/// CANCELLED; the three terminal states are final (database trigger).
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("payment_status")
}

/// PR-10: normalized type of a provider event (whatever the provider's names).
enum PaymentEventType {
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED

  @@map("payment_event_type")
}

/// PR-11: descriptive category only. It carries no legal or regulatory
/// conclusion; PR-12 owns compliance rules.
enum PassengerDocumentType {
  PASSPORT
  NATIONAL_ID
  RESIDENCE_PERMIT
  VISA
  PARENTAL_AUTHORIZATION
  OTHER

  @@map("passenger_document_type")
}

/// PR-11: technical file-security lifecycle only. ACCEPTED means that the
/// upload passed the configured technical checks, never that it is legally
/// valid or sufficient for travel.
enum PassengerDocumentStatus {
  QUARANTINED
  ACCEPTED
  REJECTED

  @@map("passenger_document_status")
}

enum RouteVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("route_version_status")
}

/// PR-12: lifecycle of one version of a regulatory rule. PUBLISHED versions
/// are immutable (only retirement is allowed); corrections are new versions.
enum ComplianceRuleVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("compliance_rule_version_status")
}

/// PR-12: provenance check of a rule version. Only VERIFIED can be published.
enum ComplianceVerificationStatus {
  UNVERIFIED
  VERIFIED

  @@map("compliance_verification_status")
}

/// PR-12: outcome of one rule version for one booking passenger.
enum ComplianceOutcome {
  PASS
  FAIL
  REVIEW_REQUIRED
  NOT_APPLICABLE

  @@map("compliance_outcome")
}

/// PR-12: overall machine result. No matching or insufficient verified rule
/// coverage is REVIEW_REQUIRED, never PASS.
enum ComplianceResult {
  PASS
  FAIL
  REVIEW_REQUIRED

  @@map("compliance_result")
}

/// PR-12: decision of an authorized STAFF reviewer (reason mandatory).
enum ComplianceReviewDecision {
  COMPLIANT
  NON_COMPLIANT
  NEEDS_INFORMATION

  @@map("compliance_review_decision")
}

/// PR-13: descriptive only; it never implies an allowance or a tariff.
enum BaggageType {
  SUITCASE
  TRAVEL_BAG
  BOX
  OTHER

  @@map("baggage_type")
}

/// PR-13: the normal operational projection. REMOVED is historical and
/// terminal; it never means physical deletion.
enum BaggageLifecycleStatus {
  REGISTERED
  CHECKED_IN
  LOADED
  IN_TRANSIT
  ARRIVED
  DELIVERED
  REMOVED

  @@map("baggage_lifecycle_status")
}

/// PR-13: an active exception stays separate from the normal stage.
enum BaggageExceptionStatus {
  MISSING
  DAMAGED
  HELD_BY_CUSTOMS

  @@map("baggage_exception_status")
}

/// PR-13 append-only business events. Projection snapshots on every event
/// make lifecycle, exception resolution and weight history independently auditable.
enum BaggageEventType {
  REGISTERED
  WEIGHT_UPDATED
  CHECKED_IN
  LOADED
  IN_TRANSIT
  ARRIVED
  DELIVERED
  MISSING
  DAMAGED
  HELD_BY_CUSTOMS
  EXCEPTION_RESOLVED
  REMOVED

  @@map("baggage_event_type")
}

/// PR-16: administrative lifecycle of one operational regulatory permit.
/// Expiration is derived from the validity dates and is never persisted.
enum RegulatoryPermitStatus {
  DRAFT
  ACTIVE
  REVOKED

  @@map("regulatory_permit_status")
}

/// PR-16: exactly one referentially constrained subject per permit. OPERATOR
/// means the single EURO TERANGA operator because no multi-operator model exists.
enum RegulatoryPermitScopeType {
  OPERATOR
  COUNTRY
  VEHICLE
  ROUTE_VERSION
  TRIP

  @@map("regulatory_permit_scope_type")
}

/// PR-17: transient construction state is never exposed by the service; a
/// successful policy publication creates and publishes the whole version in
/// one transaction. PUBLISHED versions are immutable.
enum DeparturePermitPolicyStatus {
  DRAFT
  PUBLISHED

  @@map("departure_permit_policy_status")
}

/// An identity able to authenticate in exactly one realm. It is not a
/// customer, passenger, staff profile or crew member: those business objects
/// will reference it later and stay independent.
/// CMS-1: what a content entry describes. SITE_SETTINGS and NAVIGATION are
/// singletons (fixed keys, enforced by a CHECK in the migration).
enum ContentEntryKind {
  PAGE
  SITE_SETTINGS
  NAVIGATION

  @@map("content_entry_kind")
}

/// DRAFT is editable; PUBLISHED is the live revision; SUPERSEDED is history.
enum ContentRevisionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED

  @@map("content_revision_status")
}

enum PublicMediaStatus {
  ACTIVE
  ARCHIVED

  @@map("public_media_status")
}

model AuthIdentity {
  id              String             @id @default(uuid(7)) @db.Uuid
  realm           AuthRealm
  /// Address as entered (display only).
  email           String             @db.VarChar(254)
  /// trim + lowercase; used for lookup and uniqueness (docs/security/authentication.md).
  normalizedEmail String             @map("normalized_email") @db.VarChar(254)
  status          AuthIdentityStatus
  emailVerifiedAt DateTime?          @map("email_verified_at") @db.Timestamptz(3)
  /// Incremented to invalidate every session at once (password change/reset...).
  authVersion     Int                @default(1) @map("auth_version")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordCredential      PasswordCredential?
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  challenges              AuthChallenge[]
  mfaTotpCredential       MfaTotpCredential?
  mfaRecoveryCodes        MfaRecoveryCode[]

  // PR-03 authorization, audit and STAFF provisioning.
  roleAssignments             AuthorizationRoleAssignment[] @relation("RoleAssignmentIdentity")
  roleGrantsIssued            AuthorizationRoleAssignment[] @relation("RoleAssignmentGrantedBy")
  roleRevocationsIssued       AuthorizationRoleAssignment[] @relation("RoleAssignmentRevokedBy")
  auditEvents                 AuditEvent[]                  @relation("AuditActor")
  staffInvitations            StaffInvitation[]             @relation("StaffInvitationIdentity")
  staffInvitationsCreated     StaffInvitation[]             @relation("StaffInvitationCreatedBy")
  staffEnrollmentGrant        StaffEnrollmentGrant?         @relation("StaffEnrollmentIdentity")
  staffEnrollmentGrantsIssued StaffEnrollmentGrant[]        @relation("StaffEnrollmentIssuedBy")

  // PR-09: holds created by this CUSTOMER identity (the booker, not a passenger).
  bookings                         Booking[]                @relation("BookingCustomer")
  // PR-10: payment attempts of this CUSTOMER (always the booking owner).
  payments                         Payment[]                @relation("PaymentCustomer")
  // PR-11: people for whom this CUSTOMER may make bookings. The account is
  // the owner/booker and remains distinct from the person travelling.
  passengers                       Passenger[]              @relation("PassengerOwner")
  // PR-12: provenance and decisions of regulatory compliance.
  complianceVersionsVerified       ComplianceRuleVersion[]  @relation("ComplianceVersionVerifier")
  complianceVersionsPublished      ComplianceRuleVersion[]  @relation("ComplianceVersionPublisher")
  complianceVersionsRetired        ComplianceRuleVersion[]  @relation("ComplianceVersionRetirer")
  complianceEvaluations            ComplianceEvaluation[]   @relation("ComplianceEvaluationActor")
  complianceReviews                ComplianceReview[]       @relation("ComplianceReviewer")
  baggageEvents                    BaggageEvent[]           @relation("BaggageEventActor")
  seatAssignments                  BookingPassengerSeat[]   @relation("BookingPassengerSeatAssigner")
  passengerCheckIns                PassengerCheckIn[]       @relation("PassengerCheckInActor")
  passengerBoardings               PassengerBoarding[]      @relation("PassengerBoardingActor")
  crewDevices                      CrewDevice[]             @relation("CrewDeviceOwner")
  crewDevicesRevoked               CrewDevice[]             @relation("CrewDeviceRevoker")
  crewTripAssignments              CrewTripAssignment[]     @relation("CrewTripAssignmentCrew")
  crewTripAssignmentsGranted       CrewTripAssignment[]     @relation("CrewTripAssignmentGrantor")
  crewTripAssignmentsRevoked       CrewTripAssignment[]     @relation("CrewTripAssignmentRevoker")
  passengerManifests               PassengerManifest[]      @relation("PassengerManifestGenerator")
  permitsCreated                   RegulatoryPermit[]       @relation("RegulatoryPermitCreator")
  permitsUpdated                   RegulatoryPermit[]       @relation("RegulatoryPermitUpdater")
  permitsActivated                 RegulatoryPermit[]       @relation("RegulatoryPermitActivator")
  permitsRevoked                   RegulatoryPermit[]       @relation("RegulatoryPermitRevoker")
  departurePermitPoliciesPublished DeparturePermitPolicy[]  @relation("DeparturePermitPolicyPublisher")
  departureAuthorizations          DepartureAuthorization[] @relation("DepartureAuthorizationActor")
  trackingConfigsCreated           TripTrackingConfig[]     @relation("TrackingConfigCreator")
  trackingConfigsUpdated           TripTrackingConfig[]     @relation("TrackingConfigUpdater")
  trackingObservationsCreated      TrackingObservation[]    @relation("TrackingObservationActor")
  trackingTokensCreated            TrackingPublicToken[]    @relation("TrackingPublicTokenCreator")
  trackingTokensRevoked            TrackingPublicToken[]    @relation("TrackingPublicTokenRevoker")
  trackingDevicesCreated           TrackingDevice[]         @relation("TrackingDeviceCreator")
  borderEventsRecorded             BorderEvent[]            @relation("BorderEventRecorder")
  incidentsOpened                  Incident[]               @relation("IncidentOpener")
  contentRevisionsAuthored         ContentRevision[]        @relation("ContentRevisionAuthor")
  contentRevisionsPublished        ContentRevision[]        @relation("ContentRevisionPublisher")
  publicMediaCreated               PublicMediaAsset[]       @relation("PublicMediaCreator")
  publicMediaUpdated               PublicMediaAsset[]       @relation("PublicMediaUpdater")
  publicMediaArchived              PublicMediaAsset[]       @relation("PublicMediaArchiver")
  incidentsOwned                   Incident[]               @relation("IncidentOwner")
  incidentActions                  IncidentAction[]         @relation("IncidentActionActor")
  incidentAttachments              IncidentAttachment[]     @relation("IncidentAttachmentUploader")
  financeRevenuesCreated           TripRevenue[]            @relation("TripRevenueCreator")
  financeRevenuesVoided            TripRevenue[]            @relation("TripRevenueVoider")
  financeExpensesCreated           TripExpense[]            @relation("TripExpenseCreator")
  financeExpensesVoided            TripExpense[]            @relation("TripExpenseVoider")
  refundsRecorded                  Refund[]                 @relation("RefundRecorder")
  creditNotesIssued                CreditNote[]             @relation("CreditNoteIssuer")
  payoutsRecorded                  Payout[]                 @relation("PayoutRecorder")
  financeReceiptsUploaded          FinanceReceipt[]         @relation("FinanceReceiptUploader")

  // The same address may exist in two realms as two unrelated identities.
  @@unique([realm, normalizedEmail])
  @@map("auth_identity")
}

model PasswordCredential {
  identityId   String   @id @map("identity_id") @db.Uuid
  /// PHC-encoded Argon2id hash (algorithm and parameters included).
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("password_credential")
}

/// Opaque, revocable browser session. Only SHA-256(token) is stored.
model AuthSession {
  id                String                       @id @default(uuid(7)) @db.Uuid
  identityId        String                       @map("identity_id") @db.Uuid
  tokenHash         Bytes                        @unique @map("token_hash")
  /// Copy of AuthIdentity.authVersion at creation; a mismatch invalidates the session.
  authVersion       Int                          @map("auth_version")
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime                     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime                     @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime                     @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?                    @map("revoked_at") @db.Timestamptz(3)
  revocationReason  AuthSessionRevocationReason? @map("revocation_reason")

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([absoluteExpiresAt])
  @@map("auth_session")
}

/// Single-use email verification token (hash only). It carries the password
/// hash chosen at registration, applied only when the token is verified.
model EmailVerificationToken {
  id                  String    @id @default(uuid(7)) @db.Uuid
  identityId          String    @map("identity_id") @db.Uuid
  tokenHash           Bytes     @unique @map("token_hash")
  pendingPasswordHash String?   @map("pending_password_hash")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt       DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
  @@map("email_verification_token")
}

/// Single-use password reset token (hash only).
model PasswordResetToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  identityId    String    @map("identity_id") @db.Uuid
  tokenHash     Bytes     @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

/// Short-lived, attempt-limited step between password and second factor.
model AuthChallenge {
  id         String            @id @default(uuid(7)) @db.Uuid
  identityId String            @map("identity_id") @db.Uuid
  type       AuthChallengeType
  tokenHash  Bytes             @unique @map("token_hash")
  attempts   Int               @default(0)
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?         @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
  @@map("auth_challenge")
}

/// TOTP secret, encrypted with AES-256-GCM (key outside the database).
/// enabledAt is null while enrollment is pending.
model MfaTotpCredential {
  identityId       String    @id @map("identity_id") @db.Uuid
  /// Ciphertext followed by the 16-byte GCM authentication tag.
  secretCiphertext Bytes     @map("secret_ciphertext")
  secretNonce      Bytes     @map("secret_nonce")
  keyVersion       Int       @map("key_version")
  enabledAt        DateTime? @map("enabled_at") @db.Timestamptz(3)
  /// Highest accepted 30-second time step; codes at or below it are replays.
  lastAcceptedStep BigInt?   @map("last_accepted_step")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("mfa_totp_credential")
}

/// Single-use recovery code (SHA-256 of a high-entropy code; shown once).
model MfaRecoveryCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  identityId String    @map("identity_id") @db.Uuid
  codeHash   Bytes     @unique @map("code_hash")
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("mfa_recovery_code")
}

/// Fixed-window rate-limit counter. The key is an HMAC of the action and of
/// the limited signal (IP, identity hint): no raw email or IP is stored.
model AuthRateLimitBucket {
  key         Bytes
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  action      String   @db.VarChar(64)
  count       Int
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("auth_rate_limit_bucket")
}

/// Atomic permission enforced by the API. The catalogue is seeded by
/// migrations (single source of truth) and referenced by stable keys.
model AuthorizationPermission {
  key         String   @id @db.VarChar(96)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles AuthorizationRolePermission[]

  @@map("authorization_permission")
}

/// Named set of permissions, valid in exactly one realm. System roles are
/// seeded by migrations and read-only through the API in PR-03.
model AuthorizationRole {
  key         String    @id @db.VarChar(64)
  name        String    @db.VarChar(96)
  description String    @db.VarChar(255)
  /// Realm of the identities that may hold this role (enforced by a trigger).
  realm       AuthRealm
  /// Granting, revoking, or acting on holders of a privileged role requires
  /// the privileged.manage permission.
  privileged  Boolean   @default(false)
  system      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions AuthorizationRolePermission[]
  assignments AuthorizationRoleAssignment[]

  @@map("authorization_role")
}

model AuthorizationRolePermission {
  roleKey       String @map("role_key") @db.VarChar(64)
  permissionKey String @map("permission_key") @db.VarChar(96)

  role       AuthorizationRole       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission AuthorizationPermission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleKey, permissionKey])
  @@map("authorization_role_permission")
}

/// Revocable role grant. History is never overwritten or deleted: revocation
/// closes the row and records who did it and why.
model AuthorizationRoleAssignment {
  id                  String    @id @default(uuid(7)) @db.Uuid
  identityId          String    @map("identity_id") @db.Uuid
  roleKey             String    @map("role_key") @db.VarChar(64)
  grantedByIdentityId String?   @map("granted_by_identity_id") @db.Uuid
  grantedAt           DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  grantReason         String?   @map("grant_reason") @db.VarChar(255)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByIdentityId String?   @map("revoked_by_identity_id") @db.Uuid
  revocationReason    String?   @map("revocation_reason") @db.VarChar(255)

  identity  AuthIdentity      @relation("RoleAssignmentIdentity", fields: [identityId], references: [id], onDelete: Restrict)
  role      AuthorizationRole @relation(fields: [roleKey], references: [key], onDelete: Restrict)
  grantedBy AuthIdentity?     @relation("RoleAssignmentGrantedBy", fields: [grantedByIdentityId], references: [id], onDelete: Restrict)
  revokedBy AuthIdentity?     @relation("RoleAssignmentRevokedBy", fields: [revokedByIdentityId], references: [id], onDelete: Restrict)

  @@index([identityId, revokedAt])
  @@index([roleKey, revokedAt])
  @@map("authorization_role_assignment")
}

/// Append-only audit trail of privileged actions (database triggers reject
/// UPDATE, DELETE and TRUNCATE). Values are redacted before insertion.
model AuditEvent {
  id              String     @id @default(uuid(7)) @db.Uuid
  occurredAt      DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Null for system actors (e.g. the bootstrap CLI, invitation acceptance).
  actorIdentityId String?    @map("actor_identity_id") @db.Uuid
  actorRealm      AuthRealm? @map("actor_realm")
  action          String     @db.VarChar(96)
  resourceType    String     @map("resource_type") @db.VarChar(64)
  resourceId      String?    @map("resource_id") @db.VarChar(128)
  sessionId       String?    @map("session_id") @db.Uuid
  requestId       String?    @map("request_id") @db.VarChar(128)
  before          Json?
  after           Json?
  metadata        Json?

  actor AuthIdentity? @relation("AuditActor", fields: [actorIdentityId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([actorIdentityId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@map("audit_event")
}

/// Single-use, hash-only invitation through which an administrator provisions
/// a STAFF identity (there is no public staff registration).
model StaffInvitation {
  id                  String    @id @default(uuid(7)) @db.Uuid
  identityId          String    @map("identity_id") @db.Uuid
  tokenHash           Bytes     @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt       DateTime? @map("invalidated_at") @db.Timestamptz(3)
  /// Null when created by the bootstrap CLI.
  createdByIdentityId String?   @map("created_by_identity_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  identity  AuthIdentity  @relation("StaffInvitationIdentity", fields: [identityId], references: [id], onDelete: Cascade)
  createdBy AuthIdentity? @relation("StaffInvitationCreatedBy", fields: [createdByIdentityId], references: [id], onDelete: Restrict)

  @@index([identityId])
  @@index([expiresAt])
  @@map("staff_invitation")
}

/// Explicit, expiring, single-use authorization for a STAFF identity to set
/// up its first TOTP. A correct password alone never allows enrollment.
model StaffEnrollmentGrant {
  identityId         String    @id @map("identity_id") @db.Uuid
  issuedByIdentityId String?   @map("issued_by_identity_id") @db.Uuid
  issuedAt           DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz(3)

  identity AuthIdentity  @relation("StaffEnrollmentIdentity", fields: [identityId], references: [id], onDelete: Cascade)
  issuedBy AuthIdentity? @relation("StaffEnrollmentIssuedBy", fields: [issuedByIdentityId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("staff_enrollment_grant")
}

/// ISO country catalogue used by the transport network. Countries are
/// deactivated rather than physically deleted through the API.
model Country {
  id        String   @id @default(uuid(7)) @db.Uuid
  iso2      String   @unique @db.VarChar(2)
  iso3      String   @unique @db.VarChar(3)
  name      String   @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stops                       Stop[]
  checkpoints                 Checkpoint[]
  vehicles                    Vehicle[]
  passengers                  Passenger[]                  @relation("PassengerNationality")
  permitJurisdictions         RegulatoryPermit[]           @relation("RegulatoryPermitJurisdiction")
  permitScopes                RegulatoryPermit[]           @relation("RegulatoryPermitCountryScope")
  departurePermitRequirements DeparturePermitRequirement[]

  @@index([active, id])
  @@map("country")
}

/// A passenger-facing point at which boarding or alighting may be allowed.
model Stop {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(160)
  countryId String   @map("country_id") @db.Uuid
  locality  String   @db.VarChar(128)
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  timezone  String   @db.VarChar(64)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  country   Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)
  waypoints RouteWaypoint[]

  @@index([countryId])
  @@index([active, id])
  @@map("stop")
}

/// An operational network point. Regulatory and customs rules deliberately
/// do not live on this record.
model Checkpoint {
  id        String         @id @default(uuid(7)) @db.Uuid
  code      String         @unique @db.VarChar(32)
  name      String         @db.VarChar(160)
  countryId String         @map("country_id") @db.Uuid
  type                  CheckpointType
  /// Operational purpose; constrained to remain compatible with `type`.
  terangaKind           TerangaStopKind  @default(TECHNICAL) @map("teranga_kind")
  /// Explicit traveller-facing visibility. Technical checkpoints stay hidden unless OPS opts in.
  travellerVisible      Boolean          @default(false) @map("traveller_visible")
  /// Non-binding planning hint only; actual trip times remain in TripWaypointTiming.
  suggestedDwellMinutes Int?             @map("suggested_dwell_minutes")
  /// Services explicitly verified by OPS; empty means unknown/not confirmed.
  facilities            TerangaFacility[] @default([])
  locality              String           @db.VarChar(128)
  latitude              Decimal          @db.Decimal(9, 6)
  longitude             Decimal          @db.Decimal(9, 6)
  timezone              String           @db.VarChar(64)
  active                Boolean          @default(true)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  country   Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)
  waypoints RouteWaypoint[]

  @@index([countryId])
  @@index([type])
  @@index([terangaKind])
  @@index([travellerVisible, active, id])
  @@index([active, id])
  @@map("checkpoint")
}

/// Stable commercial route identity. Its geography belongs to versions.
model Route {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions   RouteVersion[]
  fareTables FareTable[]

  @@index([active, id])
  @@map("route")
}

/// Ordered, immutable-once-published definition of a commercial route.
/// Partial unique indexes and lifecycle triggers live in the PR-04 migration.
model RouteVersion {
  id          String             @id @default(uuid(7)) @db.Uuid
  routeId     String             @map("route_id") @db.Uuid
  version     Int
  status      RouteVersionStatus @default(DRAFT)
  publishedAt DateTime?          @map("published_at") @db.Timestamptz(3)
  retiredAt   DateTime?          @map("retired_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  route             Route              @relation(fields: [routeId], references: [id], onDelete: Restrict)
  waypoints         RouteWaypoint[]
  trips             Trip[]
  fareTableVersions FareTableVersion[]
  regulatoryPermits RegulatoryPermit[]

  @@unique([routeId, version])
  @@index([status])
  @@map("route_version")
}

/// One position in a route version. Exactly one of stop/checkpoint is set;
/// the database also forbids passenger activity at checkpoint waypoints.
model RouteWaypoint {
  id               String  @id @default(uuid(7)) @db.Uuid
  routeVersionId   String  @map("route_version_id") @db.Uuid
  sequence         Int
  stopId           String? @map("stop_id") @db.Uuid
  checkpointId     String? @map("checkpoint_id") @db.Uuid
  boardingAllowed  Boolean @default(false) @map("boarding_allowed")
  alightingAllowed Boolean @default(false) @map("alighting_allowed")

  routeVersion         RouteVersion          @relation(fields: [routeVersionId], references: [id], onDelete: Restrict)
  stop                 Stop?                 @relation(fields: [stopId], references: [id], onDelete: Restrict)
  checkpoint           Checkpoint?           @relation(fields: [checkpointId], references: [id], onDelete: Restrict)
  timings              TripWaypointTiming[]
  faresFrom            FareEntry[]           @relation("FareOrigin")
  faresTo              FareEntry[]           @relation("FareDestination")
  bookingsFrom         Booking[]             @relation("BookingOrigin")
  bookingsTo           Booking[]             @relation("BookingDestination")
  baggageEvents        BaggageEvent[]
  trackingObservations TrackingObservation[]
  borderEvents         BorderEvent[]
  incidents            Incident[]

  @@unique([routeVersionId, sequence])
  @@index([stopId])
  @@index([checkpointId])
  @@map("route_waypoint")
}

/// A vehicle operated by EURO TERANGA (PR-05 fleet core). Capacity, seat
/// maps, maintenance, documents and assignments belong to later domains.
/// The lifecycle (creation as PLANNED, allowed transitions, RETIRED terminal,
/// no physical deletion) is enforced by triggers in the PR-05 migration.
model Vehicle {
  id                    String           @id @default(uuid(7)) @db.Uuid
  code                  String           @unique @db.VarChar(32)
  /// Optional operational name used by the teams (e.g. "Teranga 01").
  name                  String?          @unique @db.VarChar(80)
  /// Application-level shape check only (17 characters, no I/O/Q).
  vin                   String?          @unique @db.VarChar(17)
  registrationPlate     String?          @map("registration_plate") @db.VarChar(16)
  registrationCountryId String?          @map("registration_country_id") @db.Uuid
  manufacturer          String           @db.VarChar(80)
  model                 String           @db.VarChar(80)
  modelYear             Int?             @map("model_year")
  /// Operational use of the vehicle. Existing rows migrate as passenger coaches.
  role                  VehicleRole      @default(PASSENGER_COACH)
  /// Maximum useful load reserved for baggage/freight, in whole kilograms.
  payloadCapacityKg     Int?             @map("payload_capacity_kg")
  /// Maximum useful baggage/freight volume, stored exactly in litres (1000 L = 1 m³).
  cargoVolumeLiters    Int?             @map("cargo_volume_liters")
  status                VehicleStatus    @default(PLANNED)
  statusChangedAt       DateTime?        @map("status_changed_at") @db.Timestamptz(3)
  retiredAt             DateTime?        @map("retired_at") @db.Timestamptz(3)
  /// Physical seat map currently configured (a published version).
  seatMapVersionId      String?          @map("seat_map_version_id") @db.Uuid
  /// Main public photograph, selected from MEDIA-1.
  primaryMediaId        String?          @map("primary_media_id") @db.Uuid
  /// Equipment actually on board, maintained by the fleet team (distinct values).
  amenities             VehicleAmenity[] @default([])
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  registrationCountry Country?           @relation(fields: [registrationCountryId], references: [id], onDelete: Restrict)
  seatMapVersion      SeatMapVersion?    @relation(fields: [seatMapVersionId], references: [id], onDelete: Restrict)
  primaryMedia        PublicMediaAsset?  @relation("VehiclePrimaryMedia", fields: [primaryMediaId], references: [id], onDelete: Restrict)
  mediaGallery        VehicleMedia[]
  trips               Trip[]
  regulatoryPermits   RegulatoryPermit[]
  trackingDevices     TrackingDevice[]
  incidents           Incident[]

  @@unique([registrationCountryId, registrationPlate])
  @@index([status, id])
  @@index([seatMapVersionId])
  @@index([primaryMediaId])
  @@map("vehicle")
}

/// Ordered public gallery of one vehicle. Every image comes from MEDIA-1.
model VehicleMedia {
  id        String            @id @default(uuid(7)) @db.Uuid
  vehicleId String            @map("vehicle_id") @db.Uuid
  mediaId   String            @map("media_id") @db.Uuid
  kind      VehicleMediaKind?
  position  Int
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  vehicle Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  media   PublicMediaAsset @relation("VehicleGalleryMedia", fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([vehicleId, mediaId])
  @@unique([vehicleId, position])
  @@index([mediaId])
  @@map("vehicle_media")
}

/// One planned occurrence of a published (historical) route version (PR-06).
/// Seats, prices, bookings, crew and actual times belong to later domains.
/// The lifecycle, the frozen timetable and the scheduling validation are
/// enforced by triggers in the PR-06 migration.
model Trip {
  id                       String     @id @default(uuid(7)) @db.Uuid
  /// Public, immutable reference (e.g. ET-TEST-2030-0001 in tests).
  reference                String     @unique @db.VarChar(32)
  routeVersionId           String     @map("route_version_id") @db.Uuid
  vehicleId                String?    @map("vehicle_id") @db.Uuid
  /// Historical seat map of this trip; frozen once SCHEDULED.
  seatMapVersionId         String?    @map("seat_map_version_id") @db.Uuid
  /// Historical pricing of this trip; frozen once SCHEDULED.
  fareTableVersionId       String?    @map("fare_table_version_id") @db.Uuid
  status                   TripStatus @default(DRAFT)
  /// Departure of the first waypoint (UTC), copied from the timetable.
  plannedDepartureAt       DateTime?  @map("planned_departure_at") @db.Timestamptz(3)
  /// Arrival at the last waypoint (UTC), copied from the timetable.
  plannedArrivalAt         DateTime?  @map("planned_arrival_at") @db.Timestamptz(3)
  scheduledAt              DateTime?  @map("scheduled_at") @db.Timestamptz(3)
  cancelledAt              DateTime?  @map("cancelled_at") @db.Timestamptz(3)
  /// Authoritative database clock set on SCHEDULED -> IN_PROGRESS.
  actualDepartureAt        DateTime?  @map("actual_departure_at") @db.Timestamptz(3)
  /// Authoritative database clock set on IN_PROGRESS -> COMPLETED.
  actualArrivalAt          DateTime?  @map("actual_arrival_at") @db.Timestamptz(3)
  /// Exact immutable authorization consumed by the departure transition.
  departureAuthorizationId String?    @unique @map("departure_authorization_id") @db.Uuid
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  routeVersion            RouteVersion             @relation(fields: [routeVersionId], references: [id], onDelete: Restrict)
  vehicle                 Vehicle?                 @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  seatMapVersion          SeatMapVersion?          @relation(fields: [seatMapVersionId], references: [id], onDelete: Restrict)
  fareTableVersion        FareTableVersion?        @relation(fields: [fareTableVersionId], references: [id], onDelete: Restrict)
  timings                 TripWaypointTiming[]
  bookings                Booking[]
  seatLocks               SeatInventoryLock[]
  passengerManifests      PassengerManifest[]
  regulatoryPermits       RegulatoryPermit[]
  departurePermitPolicies DeparturePermitPolicy[]
  departureAuthorizations DepartureAuthorization[] @relation("TripDepartureAuthorizations")
  departureAuthorization  DepartureAuthorization?  @relation("TripUsedDepartureAuthorization", fields: [departureAuthorizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  crewAssignments         CrewTripAssignment[]
  trackingConfig          TripTrackingConfig?
  trackingObservations    TrackingObservation[]
  trackingPublicTokens    TrackingPublicToken[]
  borderEvents            BorderEvent[]
  incidents               Incident[]
  financeRevenues         TripRevenue[]
  financeExpenses         TripExpense[]
  costPlan                TripCostPlan?

  @@index([status, id])
  @@index([routeVersionId, id])
  @@index([plannedDepartureAt, id])
  @@index([vehicleId])
  @@index([seatMapVersionId])
  @@index([fareTableVersionId])
  @@index([actualDepartureAt, id])
  @@index([actualArrivalAt, id])
  @@map("trip")
}

/// Internal pre-departure cost plan. It is distinct from incurred expenses,
/// ticket pricing, revenue and profitability.
model TripCostPlan {
  id                String         @id @default(uuid(7)) @db.Uuid
  tripId            String         @unique @map("trip_id") @db.Uuid
  status            TripCostStatus @default(DRAFT)
  currencyCode      String         @default("EUR") @map("currency_code") @db.VarChar(3)
  currencyMinorUnit Int            @default(2) @map("currency_minor_unit")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip  Trip           @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items TripCostItem[]

  @@index([status, updatedAt])
  @@map("trip_cost_plan")
}

/// One ordered component of a trip cost plan. Amounts are integer minor units.
model TripCostItem {
  id          String           @id @default(uuid(7)) @db.Uuid
  planId      String           @map("plan_id") @db.Uuid
  category    TripCostCategory
  label       String           @db.VarChar(160)
  amountMinor BigInt           @map("amount_minor")
  notes       String?          @db.VarChar(500)
  position    Int
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan TripCostPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([planId, position])
  @@index([planId, category])
  @@map("trip_cost_item")
}

/// Planned time at one waypoint of the trip's route version (UTC). Editable
/// only while the trip is DRAFT; frozen once SCHEDULED or CANCELLED.
model TripWaypointTiming {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tripId             String    @map("trip_id") @db.Uuid
  routeWaypointId    String    @map("route_waypoint_id") @db.Uuid
  sequence           Int
  plannedArrivalAt   DateTime? @map("planned_arrival_at") @db.Timestamptz(3)
  plannedDepartureAt DateTime? @map("planned_departure_at") @db.Timestamptz(3)

  trip          Trip          @relation(fields: [tripId], references: [id], onDelete: Restrict)
  routeWaypoint RouteWaypoint @relation(fields: [routeWaypointId], references: [id], onDelete: Restrict)

  @@unique([tripId, sequence])
  @@unique([tripId, routeWaypointId])
  @@index([routeWaypointId])
  @@map("trip_waypoint_timing")
}

/// Stable identity of a seat-map model (PR-07). Its physical layout belongs
/// to numbered versions. Deactivation does not affect published versions.
model SeatMap {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions SeatMapVersion[]

  @@index([active, id])
  @@map("seat_map")
}

/// Numbered physical layout, immutable once published. Partial unique indexes
/// and lifecycle triggers live in the PR-07 migration.
model SeatMapVersion {
  id          String               @id @default(uuid(7)) @db.Uuid
  seatMapId   String               @map("seat_map_id") @db.Uuid
  version     Int
  status      SeatMapVersionStatus @default(DRAFT)
  publishedAt DateTime?            @map("published_at") @db.Timestamptz(3)
  retiredAt   DateTime?            @map("retired_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  seatMap  SeatMap       @relation(fields: [seatMapId], references: [id], onDelete: Restrict)
  cells    SeatMapCell[]
  vehicles Vehicle[]
  trips    Trip[]

  @@unique([seatMapId, version])
  @@index([status])
  @@map("seat_map_version")
}

/// One physical position of a version. Capacity = number of SEAT cells; it is
/// always computed, never stored.
model SeatMapCell {
  id               String          @id @default(uuid(7)) @db.Uuid
  seatMapVersionId String          @map("seat_map_version_id") @db.Uuid
  deck             Int
  row              Int             @map("row_number")
  column           Int             @map("column_number")
  kind             SeatMapCellKind
  seatLabel        String?         @map("seat_label") @db.VarChar(8)

  seatMapVersion SeatMapVersion      @relation(fields: [seatMapVersionId], references: [id], onDelete: Restrict)
  bookingSeats   BookingSeat[]
  seatLocks      SeatInventoryLock[]

  @@unique([seatMapVersionId, deck, row, column])
  @@unique([seatMapVersionId, seatLabel])
  @@index([seatMapVersionId, kind])
  @@map("seat_map_cell")
}

/// Stable commercial fare table of one route (PR-08). Route and currency are
/// its economic identity: immutable once created (trigger in the PR-08
/// migration). Amounts are exact integers in the currency's minor unit.
model FareTable {
  id                String   @id @default(uuid(7)) @db.Uuid
  code              String   @unique @db.VarChar(32)
  name              String   @db.VarChar(160)
  routeId           String   @map("route_id") @db.Uuid
  /// Three uppercase letters (e.g. EUR, XOF); no fixed ISO list.
  currencyCode      String   @map("currency_code") @db.VarChar(3)
  /// Digits after the decimal separator (0-3): EUR 2, XOF 0.
  currencyMinorUnit Int      @map("currency_minor_unit")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  route    Route              @relation(fields: [routeId], references: [id], onDelete: Restrict)
  versions FareTableVersion[]

  @@index([routeId])
  @@index([active, id])
  @@map("fare_table")
}

/// Historical base fares for exactly one (published) route version.
/// Immutable once published; partial unique indexes and triggers live in the
/// PR-08 migration.
model FareTableVersion {
  id             String                 @id @default(uuid(7)) @db.Uuid
  fareTableId    String                 @map("fare_table_id") @db.Uuid
  routeVersionId String                 @map("route_version_id") @db.Uuid
  version        Int
  status         FareTableVersionStatus @default(DRAFT)
  publishedAt    DateTime?              @map("published_at") @db.Timestamptz(3)
  retiredAt      DateTime?              @map("retired_at") @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  fareTable    FareTable    @relation(fields: [fareTableId], references: [id], onDelete: Restrict)
  routeVersion RouteVersion @relation(fields: [routeVersionId], references: [id], onDelete: Restrict)
  entries      FareEntry[]
  trips        Trip[]

  @@unique([fareTableId, version])
  @@index([routeVersionId])
  @@index([status])
  @@map("fare_table_version")
}

/// Base fare from one boarding stop waypoint to a later alighting stop
/// waypoint of the version's route version. The matrix may be partial: an
/// absent pair has no configured fare (nothing is ever derived).
model FareEntry {
  id                         String @id @default(uuid(7)) @db.Uuid
  fareTableVersionId         String @map("fare_table_version_id") @db.Uuid
  originRouteWaypointId      String @map("origin_route_waypoint_id") @db.Uuid
  destinationRouteWaypointId String @map("destination_route_waypoint_id") @db.Uuid
  /// Exact amount in the currency's minor unit (EUR 125,50 -> 12550).
  amountMinor                Int    @map("amount_minor")

  fareTableVersion         FareTableVersion @relation(fields: [fareTableVersionId], references: [id], onDelete: Restrict)
  originRouteWaypoint      RouteWaypoint    @relation("FareOrigin", fields: [originRouteWaypointId], references: [id], onDelete: Restrict)
  destinationRouteWaypoint RouteWaypoint    @relation("FareDestination", fields: [destinationRouteWaypointId], references: [id], onDelete: Restrict)
  bookings                 Booking[]

  @@unique([fareTableVersionId, originRouteWaypointId, destinationRouteWaypointId])
  @@index([originRouteWaypointId])
  @@index([destinationRouteWaypointId])
  @@map("fare_entry")
}

/// PR-09: a CUSTOMER's provisional hold on seats of one trip, for one
/// origin/destination pair. The customer is the booker, not a passenger: no
/// passenger data is stored. Not paid, not a ticket. Its state is derived:
/// CANCELLED (cancelledAt set), EXPIRED (holdExpiresAt <= now) or HELD.
model Booking {
  id                         String    @id @default(uuid(7)) @db.Uuid
  /// Public, immutable, unpredictable reference: ETB- + 12 CSPRNG Crockford base32 characters.
  reference                  String    @unique @db.VarChar(16)
  customerIdentityId         String    @map("customer_identity_id") @db.Uuid
  tripId                     String    @map("trip_id") @db.Uuid
  originRouteWaypointId      String    @map("origin_route_waypoint_id") @db.Uuid
  destinationRouteWaypointId String    @map("destination_route_waypoint_id") @db.Uuid
  originSequence             Int       @map("origin_sequence")
  destinationSequence        Int       @map("destination_sequence")
  /// Fare entry of the trip's historical fare table version (PR-08).
  fareEntryId                String    @map("fare_entry_id") @db.Uuid
  /// Exact snapshot of the base fare per seat, in the currency's minor unit.
  unitAmountMinor            Int       @map("unit_amount_minor")
  currencyCode               String    @map("currency_code") @db.VarChar(3)
  currencyMinorUnit          Int       @map("currency_minor_unit")
  holdExpiresAt              DateTime  @map("hold_expires_at") @db.Timestamptz(3)
  cancelledAt                DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason         String?   @map("cancellation_reason") @db.VarChar(500)
  /// PR-10: set once, by a succeeded payment, while the hold is active. A
  /// confirmed booking keeps its seats after holdExpiresAt.
  confirmedAt                DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  customerIdentity         AuthIdentity       @relation("BookingCustomer", fields: [customerIdentityId], references: [id], onDelete: Restrict)
  trip                     Trip               @relation(fields: [tripId], references: [id], onDelete: Restrict)
  originRouteWaypoint      RouteWaypoint      @relation("BookingOrigin", fields: [originRouteWaypointId], references: [id], onDelete: Restrict)
  destinationRouteWaypoint RouteWaypoint      @relation("BookingDestination", fields: [destinationRouteWaypointId], references: [id], onDelete: Restrict)
  fareEntry                FareEntry          @relation(fields: [fareEntryId], references: [id], onDelete: Restrict)
  seats                    BookingSeat[]
  payments                 Payment[]
  paymentQuotes            PaymentQuote[]
  passengers               BookingPassenger[]

  @@index([customerIdentityId, id])
  @@index([tripId, id])
  @@index([holdExpiresAt, id])
  @@index([originRouteWaypointId])
  @@index([destinationRouteWaypointId])
  @@index([fareEntryId])
  @@map("booking")
}

/// PR-11: minimal person-travelling foundation. This is deliberately not an
/// authentication identity and contains no document number or file bytes.
model Passenger {
  id                      String   @id @default(uuid(7)) @db.Uuid
  /// Public, immutable, unpredictable reference: ETV- + 12 CSPRNG Crockford base32 characters.
  reference               String   @unique @db.VarChar(16)
  ownerCustomerIdentityId String   @map("owner_customer_identity_id") @db.Uuid
  givenName               String   @map("given_name") @db.VarChar(100)
  familyName              String   @map("family_name") @db.VarChar(100)
  dateOfBirth             DateTime @map("date_of_birth") @db.Date
  nationalityCountryId    String   @map("nationality_country_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownerCustomerIdentity AuthIdentity        @relation("PassengerOwner", fields: [ownerCustomerIdentityId], references: [id], onDelete: Restrict)
  nationalityCountry    Country             @relation("PassengerNationality", fields: [nationalityCountryId], references: [id], onDelete: Restrict)
  bookings              BookingPassenger[]
  documents             PassengerDocument[]

  @@index([ownerCustomerIdentityId, id])
  @@index([nationalityCountryId])
  @@map("passenger")
}

/// PR-11: historical association between a confirmed booking and one person
/// travelling. The database trigger serializes inserts on the Booking row and
/// prevents the number of passengers from exceeding its booked seats.
model BookingPassenger {
  bookingId   String   @map("booking_id") @db.Uuid
  passengerId String   @map("passenger_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking               Booking                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  passenger             Passenger              @relation(fields: [passengerId], references: [id], onDelete: Restrict)
  complianceEvaluations ComplianceEvaluation[]
  baggage               Baggage[]
  seatAssignment        BookingPassengerSeat?
  checkIn               PassengerCheckIn?

  @@id([bookingId, passengerId])
  @@index([passengerId, bookingId])
  @@map("booking_passenger")
}

/// PR-13: one physical bag on one concrete BookingPassenger. Booking, trip,
/// CUSTOMER owner and passenger are derived through the composite relation;
/// they are never independently selected by a browser.
model Baggage {
  id                       String                  @id @default(uuid(7)) @db.Uuid
  /// Public, immutable, unpredictable reference: ETG- + 12 Crockford characters.
  reference                String                  @unique @db.VarChar(16)
  bookingId                String                  @map("booking_id") @db.Uuid
  passengerId              String                  @map("passenger_id") @db.Uuid
  type                     BaggageType
  lifecycleStatus          BaggageLifecycleStatus  @default(REGISTERED) @map("lifecycle_status")
  exceptionStatus          BaggageExceptionStatus? @map("exception_status")
  /// Official STAFF measurement. Public views serialize the exact decimal as a string.
  measuredWeightKg         Decimal?                @map("measured_weight_kg") @db.Decimal(6, 3)
  /// Reserved server snapshots for a future versioned allowance policy. PR-13
  /// never populates them and never creates a payment from them.
  includedWeightKg         Decimal?                @map("included_weight_kg") @db.Decimal(6, 3)
  excessWeightKg           Decimal?                @map("excess_weight_kg") @db.Decimal(6, 3)
  excessChargeMinor        BigInt?                 @map("excess_charge_minor")
  excessChargeCurrencyCode String?                 @map("excess_charge_currency_code") @db.VarChar(3)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookingPassenger BookingPassenger @relation(fields: [bookingId, passengerId], references: [bookingId, passengerId], onDelete: Restrict, map: "baggage_booking_passenger_fkey")
  events           BaggageEvent[]
  incidents        Incident[]
  financeRevenues  TripRevenue[]

  @@index([bookingId, passengerId, id])
  @@index([lifecycleStatus, id])
  @@index([exceptionStatus, id])
  @@index([createdAt, id])
  @@map("baggage")
}

/// PR-13: immutable event stream and resulting projection snapshots. The
/// database serializes inserts on Baggage and validates the final projection.
model BaggageEvent {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  baggageId          String                  @map("baggage_id") @db.Uuid
  sequence           Int
  type               BaggageEventType
  lifecycleStatus    BaggageLifecycleStatus  @map("lifecycle_status")
  exceptionStatus    BaggageExceptionStatus? @map("exception_status")
  measuredWeightKg   Decimal?                @map("measured_weight_kg") @db.Decimal(6, 3)
  occurredAt         DateTime                @map("occurred_at") @db.Timestamptz(3)
  recordedAt         DateTime                @default(now()) @map("recorded_at") @db.Timestamptz(3)
  actorIdentityId    String                  @map("actor_identity_id") @db.Uuid
  routeWaypointId    String?                 @map("route_waypoint_id") @db.Uuid
  clientEventId      String?                 @map("client_event_id") @db.VarChar(64)
  payloadFingerprint String                  @map("payload_fingerprint") @db.Char(64)

  baggage       Baggage        @relation(fields: [baggageId], references: [id], onDelete: Restrict)
  actor         AuthIdentity   @relation("BaggageEventActor", fields: [actorIdentityId], references: [id], onDelete: Restrict)
  routeWaypoint RouteWaypoint? @relation(fields: [routeWaypointId], references: [id], onDelete: Restrict)

  @@unique([baggageId, sequence])
  @@unique([baggageId, clientEventId])
  @@index([actorIdentityId, recordedAt])
  @@index([routeWaypointId])
  @@index([type, recordedAt])
  @@map("baggage_event")
}

/// PR-11: metadata of a private object. PostgreSQL never stores the binary,
/// original filename, scanner output, signed URL or document number.
model PassengerDocument {
  id          String                  @id @default(uuid(7)) @db.Uuid
  /// Public, immutable, unpredictable reference: ETD- + 12 CSPRNG Crockford base32 characters.
  reference   String                  @unique @db.VarChar(16)
  passengerId String                  @map("passenger_id") @db.Uuid
  type        PassengerDocumentType
  objectKey   String                  @unique @map("object_key") @db.VarChar(128)
  sha256      String                  @db.Char(64)
  mimeType    String                  @map("mime_type") @db.VarChar(64)
  sizeBytes   BigInt                  @map("size_bytes")
  status      PassengerDocumentStatus @default(QUARANTINED)
  /// Stable technical code only; never a raw scanner response.
  failureCode String?                 @map("failure_code") @db.VarChar(48)
  /// Optional document date supplied as metadata; PR-11 draws no compliance conclusion from it.
  expiresAt   DateTime?               @map("expires_at") @db.Date
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  acceptedAt  DateTime?               @map("accepted_at") @db.Timestamptz(3)
  rejectedAt  DateTime?               @map("rejected_at") @db.Timestamptz(3)

  passenger          Passenger                      @relation(fields: [passengerId], references: [id], onDelete: Restrict)
  complianceEvidence ComplianceEvaluationEvidence[]

  @@index([passengerId, id])
  @@index([status, id])
  @@index([type, id])
  @@index([createdAt, id])
  @@map("passenger_document")
}

/// PR-09: one seat chosen by a booking. Historical: never deleted; released
/// (releasedAt) when the hold is cancelled or has expired.
model BookingSeat {
  id            String    @id @default(uuid(7)) @db.Uuid
  bookingId     String    @map("booking_id") @db.Uuid
  seatMapCellId String    @map("seat_map_cell_id") @db.Uuid
  releasedAt    DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  booking        Booking                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  seatMapCell    SeatMapCell            @relation(fields: [seatMapCellId], references: [id], onDelete: Restrict)
  locks          SeatInventoryLock[]
  /// PR-14: the BookingPassenger this booked seat is assigned to, if any.
  passengerSeats BookingPassengerSeat[]

  @@unique([bookingId, seatMapCellId])
  /// PR-14: target of the composite (seat, booking) foreign key.
  @@unique([id, bookingId])
  @@index([seatMapCellId])
  @@map("booking_seat")
}

/// PR-09: operational occupancy of one seat on one segment of a trip
/// (segment n = from waypoint sequence n to n + 1). The unique index on
/// (trip, seat, segment) physically prevents overbooking. Ephemeral: deleted
/// once its booking is cancelled or expired.
model SeatInventoryLock {
  id              String   @id @default(uuid(7)) @db.Uuid
  bookingSeatId   String   @map("booking_seat_id") @db.Uuid
  tripId          String   @map("trip_id") @db.Uuid
  seatMapCellId   String   @map("seat_map_cell_id") @db.Uuid
  segmentSequence Int      @map("segment_sequence")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  bookingSeat BookingSeat @relation(fields: [bookingSeatId], references: [id], onDelete: Restrict)
  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Restrict)
  seatMapCell SeatMapCell @relation(fields: [seatMapCellId], references: [id], onDelete: Restrict)

  @@unique([tripId, seatMapCellId, segmentSequence])
  @@unique([bookingSeatId, segmentSequence])
  @@index([seatMapCellId])
  @@map("seat_inventory_lock")
}

/// PR-10: one payment attempt for a booking. The amount is derived by the
/// server from the booking (unit fare x seats) and checked by PostgreSQL;
/// no card or bank data is ever stored. History is kept: a new attempt is a
/// new row, and at most one attempt per booking is PENDING or SUCCEEDED.
model Payment {
  id                 String          @id @default(uuid(7)) @db.Uuid
  /// Public, immutable, unpredictable reference: ETP- + 12 CSPRNG Crockford base32 characters.
  reference          String          @unique @db.VarChar(16)
  bookingId          String          @map("booking_id") @db.Uuid
  /// The paying CUSTOMER: always the owner of the booking (trigger).
  customerIdentityId String          @map("customer_identity_id") @db.Uuid
  /// PAY-HUB-1: the immutable quote this attempt was started from. NULL only
  /// for PR-10 attempts (made before quotes existed); payment_guard requires
  /// it for every new attempt.
  quoteId            String?         @unique @map("quote_id") @db.Uuid
  provider           PaymentProvider
  /// Opaque id of the attempt at the provider (never a secret).
  providerPaymentId  String?         @map("provider_payment_id") @db.VarChar(128)
  status             PaymentStatus   @default(PENDING)
  /// Exact amount in the currency's minor unit (BIGINT: seats x fare can exceed 2^31).
  amountMinor        BigInt          @map("amount_minor")
  currencyCode       String          @map("currency_code") @db.VarChar(3)
  currencyMinorUnit  Int             @map("currency_minor_unit")
  /// Client-chosen key making the initiation idempotent for this customer.
  idempotencyKey     String?         @map("idempotency_key") @db.VarChar(64)
  /// Normalized, bounded code (never raw provider text); set when FAILED.
  failureCode        String?         @map("failure_code") @db.VarChar(48)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  succeededAt        DateTime?       @map("succeeded_at") @db.Timestamptz(3)
  failedAt           DateTime?       @map("failed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?       @map("cancelled_at") @db.Timestamptz(3)

  booking          Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerIdentity AuthIdentity       @relation("PaymentCustomer", fields: [customerIdentityId], references: [id], onDelete: Restrict)
  quote            PaymentQuote?      @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  events           PaymentEvent[]
  refunds          Refund[]
  settlement       PaymentSettlement?

  // At most one PENDING and one SUCCEEDED attempt per booking: partial unique
  // indexes created in the PR-10 migration (like the earlier partial indexes,
  // they are not expressible here without a preview feature, see ADR-027).
  @@unique([provider, providerPaymentId])
  @@unique([customerIdentityId, idempotencyKey])
  @@index([bookingId, id])
  @@index([status, id])
  @@map("payment")
}

/// PAY-HUB-1: immutable conversion and routing snapshot shown to the customer
/// before initiation. Payment.amount remains the booking amount; provider
/// calls and events use the presentment amount stored here. Immutable
/// (payment_quote_guard): a new price is a new quote. The presented amount is
/// the booking amount at fxRate, rounded half up (payment_quote_presentment_from_rate).
model PaymentQuote {
  id                           String          @id @default(uuid(7)) @db.Uuid
  bookingId                    String          @map("booking_id") @db.Uuid
  bookingAmountMinor           BigInt          @map("booking_amount_minor")
  bookingCurrencyCode          String          @map("booking_currency_code") @db.VarChar(3)
  bookingCurrencyMinorUnit     Int             @map("booking_currency_minor_unit")
  presentmentAmountMinor       BigInt          @map("presentment_amount_minor")
  presentmentCurrencyCode      String          @map("presentment_currency_code") @db.VarChar(3)
  presentmentCurrencyMinorUnit Int             @map("presentment_currency_minor_unit")
  /// Exact decimal rate from booking major units to presentment major units
  /// (1 with FX_IDENTITY, when both currencies are the same).
  fxRate                       Decimal         @map("fx_rate") @db.Decimal(30, 12)
  fxSource                     PaymentFxSource @map("fx_source")
  quotedAt                     DateTime        @map("quoted_at") @db.Timestamptz(3)
  expiresAt                    DateTime        @map("expires_at") @db.Timestamptz(3)
  payerCountry                 String          @map("payer_country") @db.Char(2)
  paymentMethod                PaymentMethod   @map("payment_method")
  /// Internal router decision at quote time; never exposed to the customer.
  /// The attempt may use another provider of the same method (fallback).
  providerCandidate            PaymentProvider @map("provider_candidate")

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment Payment?

  @@index([bookingId, quotedAt, id])
  @@index([payerCountry, paymentMethod, quotedAt])
  @@map("payment_quote")
}

/// PAY-HUB-1: bank/provider settlement is distinct from payment success.
/// The row is append-only and may arrive well after the booking confirmation.
model PaymentSettlement {
  id                          String          @id @default(uuid(7)) @db.Uuid
  paymentId                   String          @unique @map("payment_id") @db.Uuid
  provider                    PaymentProvider
  providerTransactionId       String          @map("provider_transaction_id") @db.VarChar(128)
  settlementReference         String          @map("settlement_reference") @db.VarChar(128)
  grossAmountMinor            BigInt          @map("gross_amount_minor")
  providerFeeMinor            BigInt          @map("provider_fee_minor")
  netAmountMinor              BigInt          @map("net_amount_minor")
  settlementCurrencyCode      String          @map("settlement_currency_code") @db.VarChar(3)
  settlementCurrencyMinorUnit Int             @map("settlement_currency_minor_unit")
  settledAt                   DateTime        @map("settled_at") @db.Timestamptz(3)
  recordedAt                  DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, settlementReference])
  @@index([settledAt, id])
  @@map("payment_settlement")
}

/// PR-10: one provider event received through a signed webhook. Immutable:
/// recorded once (unique provider event id: replay protection), with the
/// SHA-256 of its raw payload instead of the payload itself.
model PaymentEvent {
  id              String           @id @default(uuid(7)) @db.Uuid
  paymentId       String           @map("payment_id") @db.Uuid
  provider        PaymentProvider
  providerEventId String           @map("provider_event_id") @db.VarChar(128)
  type            PaymentEventType
  /// Hex SHA-256 of the raw signed payload.
  payloadHash     String           @map("payload_hash") @db.Char(64)
  receivedAt      DateTime         @map("received_at") @db.Timestamptz(3)
  /// Set when the event moved the payment out of PENDING.
  processedAt     DateTime?        @map("processed_at") @db.Timestamptz(3)
  /// Stable reason why a recorded event changed nothing (null when processed).
  rejectionCode   String?          @map("rejection_code") @db.VarChar(48)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([paymentId, id])
  @@map("payment_event")
}

/// PR-12: stable identity of one regulatory rule. The source code is never the
/// legal authority: requirements live in verified, published versions only.
model ComplianceRule {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Public, immutable reference: ETCR- + 12 CSPRNG Crockford base32 characters.
  reference String   @unique @db.VarChar(17)
  /// Internal administrative label, immutable after creation.
  title     String   @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions ComplianceRuleVersion[]

  @@map("compliance_rule")
}

/// PR-12: one version of a rule. DRAFT content can change (and loses its
/// verification); PUBLISHED is immutable except for retirement. Lifecycle
/// triggers, CHECKs and the one-draft index live in the PR-12 migration.
model ComplianceRuleVersion {
  id                       String                       @id @default(uuid(7)) @db.Uuid
  ruleId                   String                       @map("rule_id") @db.Uuid
  version                  Int
  status                   ComplianceRuleVersionStatus  @default(DRAFT)
  /// Version of the closed rule language (`definition` grammar).
  languageVersion          Int                          @default(1) @map("language_version")
  /// Strict, non-executable JSON (validated server-side, never evaluated as code).
  definition               Json                         @db.JsonB
  /// SHA-256 of the canonical JSON of `definition`.
  definitionSha256         String                       @map("definition_sha256") @db.Char(64)
  /// Plain text shown to customers when the rule is not satisfied.
  customerGuidance         String                       @map("customer_guidance") @db.VarChar(500)
  /// Inclusive calendar dates compared with the planned travel date.
  effectiveFrom            DateTime                     @map("effective_from") @db.Date
  effectiveTo              DateTime?                    @map("effective_to") @db.Date
  sourceAuthority          String?                      @map("source_authority") @db.VarChar(200)
  sourceTitle              String?                      @map("source_title") @db.VarChar(300)
  sourceUrl                String?                      @map("source_url") @db.VarChar(2048)
  sourceReference          String?                      @map("source_reference") @db.VarChar(200)
  sourceCheckedOn          DateTime?                    @map("source_checked_on") @db.Date
  verificationStatus       ComplianceVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt               DateTime?                    @map("verified_at") @db.Timestamptz(3)
  verifiedByIdentityId     String?                      @map("verified_by_identity_id") @db.Uuid
  /// The exact definition that was verified; publication requires a match.
  verifiedDefinitionSha256 String?                      @map("verified_definition_sha256") @db.Char(64)
  verificationNote         String?                      @map("verification_note") @db.VarChar(1000)
  publishedAt              DateTime?                    @map("published_at") @db.Timestamptz(3)
  publishedByIdentityId    String?                      @map("published_by_identity_id") @db.Uuid
  retiredAt                DateTime?                    @map("retired_at") @db.Timestamptz(3)
  retiredByIdentityId      String?                      @map("retired_by_identity_id") @db.Uuid
  retirementReason         String?                      @map("retirement_reason") @db.VarChar(500)
  createdAt                DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  rule        ComplianceRule               @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  verifiedBy  AuthIdentity?                @relation("ComplianceVersionVerifier", fields: [verifiedByIdentityId], references: [id], onDelete: Restrict)
  publishedBy AuthIdentity?                @relation("ComplianceVersionPublisher", fields: [publishedByIdentityId], references: [id], onDelete: Restrict)
  retiredBy   AuthIdentity?                @relation("ComplianceVersionRetirer", fields: [retiredByIdentityId], references: [id], onDelete: Restrict)
  results     ComplianceEvaluationResult[]

  @@unique([ruleId, version])
  @@index([status, effectiveFrom])
  @@index([verifiedByIdentityId])
  @@index([publishedByIdentityId])
  @@index([retiredByIdentityId])
  @@map("compliance_rule_version")
}

/// PR-12: append-only machine evaluation of one booking passenger (the
/// person on one concrete journey). Facts are server-derived and minimized.
model ComplianceEvaluation {
  id               String           @id @default(uuid(7)) @db.Uuid
  /// Public, immutable reference: ETCE- + 12 CSPRNG Crockford base32 characters.
  reference        String           @unique @db.VarChar(17)
  bookingId        String           @map("booking_id") @db.Uuid
  passengerId      String           @map("passenger_id") @db.Uuid
  /// Local calendar date of departure at the booked origin stop.
  travelDate       DateTime         @map("travel_date") @db.Date
  /// Local calendar date of arrival at the booked destination stop.
  arrivalDate      DateTime         @map("arrival_date") @db.Date
  engineVersion    String           @map("engine_version") @db.VarChar(32)
  /// Minimized fact snapshot: countries, age, document references/types/expiry.
  facts            Json             @db.JsonB
  factsFingerprint String           @map("facts_fingerprint") @db.Char(64)
  rulesFingerprint String           @map("rules_fingerprint") @db.Char(64)
  result           ComplianceResult
  /// Evaluation-level stable codes (e.g. missing verified coverage).
  findings         Json             @default("[]") @db.JsonB
  actorIdentityId  String           @map("actor_identity_id") @db.Uuid
  evaluatedAt      DateTime         @default(now()) @map("evaluated_at") @db.Timestamptz(3)

  bookingPassenger BookingPassenger             @relation(fields: [bookingId, passengerId], references: [bookingId, passengerId], onDelete: Restrict)
  actor            AuthIdentity                 @relation("ComplianceEvaluationActor", fields: [actorIdentityId], references: [id], onDelete: Restrict)
  results          ComplianceEvaluationResult[]
  reviews          ComplianceReview[]
  checkIns         PassengerCheckIn[]

  @@index([bookingId, passengerId, evaluatedAt])
  @@index([result, id])
  @@index([travelDate, id])
  @@index([actorIdentityId])
  @@map("compliance_evaluation")
}

/// PR-12: outcome of one published rule version inside one evaluation.
model ComplianceEvaluationResult {
  id            String            @id @default(uuid(7)) @db.Uuid
  evaluationId  String            @map("evaluation_id") @db.Uuid
  ruleVersionId String            @map("rule_version_id") @db.Uuid
  outcome       ComplianceOutcome
  /// Stable machine reason code, never a free legal sentence.
  reasonCode    String            @map("reason_code") @db.VarChar(64)
  /// Leaf findings: stable codes and document types only.
  details       Json              @default("[]") @db.JsonB

  evaluation  ComplianceEvaluation           @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  ruleVersion ComplianceRuleVersion          @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  evidence    ComplianceEvaluationEvidence[]

  @@unique([evaluationId, ruleVersionId])
  @@index([ruleVersionId])
  @@map("compliance_evaluation_result")
}

/// PR-12: a technically ACCEPTED document used as evidence for one result.
/// Technical acceptance stays distinct from regulatory sufficiency.
model ComplianceEvaluationEvidence {
  evaluationResultId  String @map("evaluation_result_id") @db.Uuid
  passengerDocumentId String @map("passenger_document_id") @db.Uuid

  evaluationResult  ComplianceEvaluationResult @relation(fields: [evaluationResultId], references: [id], onDelete: Restrict)
  passengerDocument PassengerDocument          @relation(fields: [passengerDocumentId], references: [id], onDelete: Restrict)

  @@id([evaluationResultId, passengerDocumentId])
  @@index([passengerDocumentId])
  @@map("compliance_evaluation_evidence")
}

/// PR-12: append-only human decision on one evaluation. A later review
/// supersedes exactly one earlier review of the same evaluation.
model ComplianceReview {
  id                 String                   @id @default(uuid(7)) @db.Uuid
  evaluationId       String                   @map("evaluation_id") @db.Uuid
  supersedesReviewId String?                  @unique @map("supersedes_review_id") @db.Uuid
  decision           ComplianceReviewDecision
  /// Internal reason (mandatory, never shown to the customer).
  reason             String                   @db.VarChar(1000)
  /// Optional plain text the customer may see.
  customerMessage    String?                  @map("customer_message") @db.VarChar(500)
  reviewerIdentityId String                   @map("reviewer_identity_id") @db.Uuid
  reviewedAt         DateTime                 @default(now()) @map("reviewed_at") @db.Timestamptz(3)

  evaluation   ComplianceEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  supersedes   ComplianceReview?    @relation("ComplianceReviewChain", fields: [supersedesReviewId], references: [id], onDelete: Restrict)
  supersededBy ComplianceReview?    @relation("ComplianceReviewChain")
  reviewer     AuthIdentity         @relation("ComplianceReviewer", fields: [reviewerIdentityId], references: [id], onDelete: Restrict)
  checkIns     PassengerCheckIn[]

  @@index([evaluationId, reviewedAt])
  @@index([reviewerIdentityId])
  @@map("compliance_review")
}

/// PR-14: the one booked seat of one BookingPassenger. It only links an
/// existing, unreleased BookingSeat of the same booking (PR-09 stays the
/// inventory authority): it creates, prices and releases nothing. It can be
/// changed until the passenger is checked in, never afterwards.
model BookingPassengerSeat {
  bookingId            String   @map("booking_id") @db.Uuid
  passengerId          String   @map("passenger_id") @db.Uuid
  bookingSeatId        String   @unique @map("booking_seat_id") @db.Uuid
  assignedByIdentityId String   @map("assigned_by_identity_id") @db.Uuid
  /// Server clock of the latest (re)assignment, set by the trigger.
  assignedAt           DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  bookingPassenger BookingPassenger   @relation(fields: [bookingId, passengerId], references: [bookingId, passengerId], onDelete: Restrict, map: "booking_passenger_seat_booking_passenger_fkey")
  bookingSeat      BookingSeat        @relation(fields: [bookingSeatId, bookingId], references: [id, bookingId], onDelete: Restrict, map: "booking_passenger_seat_booking_seat_fkey")
  assignedBy       AuthIdentity       @relation("BookingPassengerSeatAssigner", fields: [assignedByIdentityId], references: [id], onDelete: Restrict)
  checkIns         PassengerCheckIn[]

  @@id([bookingId, passengerId])
  /// Target of the check-in foreign key: a check-in pins this exact seat.
  @@unique([bookingId, passengerId, bookingSeatId])
  @@index([assignedByIdentityId])
  @@map("booking_passenger_seat")
}

/// PR-14: the one successful check-in of one BookingPassenger. Append-only
/// fact with a minimized readiness snapshot and fingerprint. It carries the
/// opaque boarding credential identified by the passenger QR (ETPAX1:...).
model PassengerCheckIn {
  id                     String   @id @default(uuid(7)) @db.Uuid
  /// Public, immutable reference: ETK- + 12 CSPRNG Crockford base32 characters.
  reference              String   @unique @db.VarChar(16)
  /// Boarding credential: ETQ- + 16 CSPRNG characters. Identifies, never authorizes.
  credentialReference    String   @unique @map("credential_reference") @db.VarChar(20)
  bookingId              String   @map("booking_id") @db.Uuid
  passengerId            String   @map("passenger_id") @db.Uuid
  bookingSeatId          String   @map("booking_seat_id") @db.Uuid
  complianceEvaluationId String   @map("compliance_evaluation_id") @db.Uuid
  complianceReviewId     String?  @map("compliance_review_id") @db.Uuid
  engineVersion          String   @map("engine_version") @db.VarChar(32)
  readinessFingerprint   String   @map("readiness_fingerprint") @db.Char(64)
  /// References, statuses and codes only: no name, document number or file.
  readinessSnapshot      Json     @map("readiness_snapshot") @db.JsonB
  checkedInByIdentityId  String   @map("checked_in_by_identity_id") @db.Uuid
  /// Server clock, set by the trigger.
  checkedInAt            DateTime @default(now()) @map("checked_in_at") @db.Timestamptz(3)

  bookingPassenger     BookingPassenger     @relation(fields: [bookingId, passengerId], references: [bookingId, passengerId], onDelete: Restrict, onUpdate: Restrict, map: "passenger_check_in_booking_passenger_fkey")
  seatAssignment       BookingPassengerSeat @relation(fields: [bookingId, passengerId, bookingSeatId], references: [bookingId, passengerId, bookingSeatId], onDelete: Restrict, onUpdate: Restrict, map: "passenger_check_in_seat_assignment_fkey")
  complianceEvaluation ComplianceEvaluation @relation(fields: [complianceEvaluationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  complianceReview     ComplianceReview?    @relation(fields: [complianceReviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checkedInBy          AuthIdentity         @relation("PassengerCheckInActor", fields: [checkedInByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  boarding             PassengerBoarding?

  @@unique([bookingId, passengerId])
  @@index([checkedInAt, id])
  @@index([complianceEvaluationId])
  @@index([complianceReviewId])
  @@index([checkedInByIdentityId])
  @@map("passenger_check_in")
}

/// PR-14: the one boarding of one checked-in BookingPassenger. Append-only;
/// the unique check-in makes double boarding physically impossible.
/// PR-19: provider/device catalogue. Provider identifiers are operational
/// metadata only; they are never authentication credentials.
model TrackingDevice {
  id                  String   @id @default(uuid(7)) @db.Uuid
  vehicleId           String   @map("vehicle_id") @db.Uuid
  providerKey         String   @map("provider_key") @db.VarChar(64)
  externalId          String   @map("external_id") @db.VarChar(128)
  active              Boolean  @default(true)
  createdByIdentityId String   @map("created_by_identity_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicle   Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy AuthIdentity         @relation("TrackingDeviceCreator", fields: [createdByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  configs   TripTrackingConfig[]

  @@unique([providerKey, externalId])
  @@index([vehicleId, active])
  @@map("tracking_device")
}

/// One mutable policy row per trip. Every policy mutation is audited in the
/// same transaction; deleting the row is forbidden by the PR-19 migration.
model TripTrackingConfig {
  tripId              String             @id @map("trip_id") @db.Uuid
  enabled             Boolean            @default(false)
  visibility          TrackingVisibility @default(HIDDEN)
  trackingDeviceId    String?            @map("tracking_device_id") @db.Uuid
  createdByIdentityId String             @map("created_by_identity_id") @db.Uuid
  updatedByIdentityId String             @map("updated_by_identity_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  trackingDevice TrackingDevice? @relation(fields: [trackingDeviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      AuthIdentity    @relation("TrackingConfigCreator", fields: [createdByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy      AuthIdentity    @relation("TrackingConfigUpdater", fields: [updatedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([enabled, visibility])
  @@index([trackingDeviceId])
  @@map("trip_tracking_config")
}

/// Append-only operational observation. Public endpoints never return this
/// record directly: they build a visibility-safe projection.
model TrackingObservation {
  id                    String                    @id @default(uuid(7)) @db.Uuid
  tripId                String                    @map("trip_id") @db.Uuid
  source                TrackingObservationSource
  providerKey           String?                   @map("provider_key") @db.VarChar(64)
  providerDeviceId      String?                   @map("provider_device_id") @db.VarChar(128)
  providerObservationId String?                   @map("provider_observation_id") @db.VarChar(128)
  clientEventId         String?                   @map("client_event_id") @db.VarChar(64)
  payloadFingerprint    String                    @map("payload_fingerprint") @db.Char(64)
  observedAt            DateTime                  @map("observed_at") @db.Timestamptz(3)
  receivedAt            DateTime                  @default(now()) @map("received_at") @db.Timestamptz(3)
  latitude              Decimal?                  @db.Decimal(9, 6)
  longitude             Decimal?                  @db.Decimal(9, 6)
  accuracyMeters        Decimal?                  @map("accuracy_meters") @db.Decimal(8, 2)
  speedKph              Decimal?                  @map("speed_kph") @db.Decimal(8, 2)
  headingDegrees        Decimal?                  @map("heading_degrees") @db.Decimal(6, 2)
  routeWaypointId       String?                   @map("route_waypoint_id") @db.Uuid
  label                 String?                   @db.VarChar(160)
  createdByIdentityId   String?                   @map("created_by_identity_id") @db.Uuid
  crewAssignmentId      String?                   @map("crew_assignment_id") @db.Uuid
  crewDeviceId          String?                   @map("crew_device_id") @db.Uuid

  trip           Trip                @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  routeWaypoint  RouteWaypoint?      @relation(fields: [routeWaypointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      AuthIdentity?       @relation("TrackingObservationActor", fields: [createdByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  crewAssignment CrewTripAssignment? @relation(fields: [crewAssignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  crewDevice     CrewDevice?         @relation(fields: [crewDeviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tripId, clientEventId])
  @@unique([providerKey, providerObservationId])
  @@index([tripId, observedAt, id])
  @@index([source, observedAt])
  @@index([routeWaypointId])
  @@index([crewAssignmentId])
  @@index([crewDeviceId])
  @@map("tracking_observation")
}

/// Revocable hash-only public capability. The raw token is returned once at
/// issuance and never persisted.
model TrackingPublicToken {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tripId              String    @map("trip_id") @db.Uuid
  tokenHash           Bytes     @unique @map("token_hash")
  createdByIdentityId String    @map("created_by_identity_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByIdentityId String?   @map("revoked_by_identity_id") @db.Uuid
  revocationReason    String?   @map("revocation_reason") @db.VarChar(255)

  trip      Trip          @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy AuthIdentity  @relation("TrackingPublicTokenCreator", fields: [createdByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy AuthIdentity? @relation("TrackingPublicTokenRevoker", fields: [revokedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tripId, revokedAt, expiresAt])
  @@map("tracking_public_token")
}

/// PR-20: immutable operational border event for one BORDER waypoint of one
/// in-progress trip. The event stream is the source of truth; current status
/// is derived from the latest event, never stored separately.
model BorderEvent {
  id                   String            @id @default(uuid(7)) @db.Uuid
  tripId               String            @map("trip_id") @db.Uuid
  routeWaypointId      String            @map("route_waypoint_id") @db.Uuid
  type                 BorderEventType
  source               BorderEventSource
  clientEventId        String            @map("client_event_id") @db.VarChar(64)
  payloadFingerprint   String            @map("payload_fingerprint") @db.Char(64)
  occurredAt           DateTime          @map("occurred_at") @db.Timestamptz(3)
  recordedAt           DateTime          @default(now()) @map("recorded_at") @db.Timestamptz(3)
  recordedByIdentityId String            @map("recorded_by_identity_id") @db.Uuid
  crewAssignmentId     String?           @map("crew_assignment_id") @db.Uuid
  crewDeviceId         String?           @map("crew_device_id") @db.Uuid

  trip           Trip                @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  routeWaypoint  RouteWaypoint       @relation(fields: [routeWaypointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy     AuthIdentity        @relation("BorderEventRecorder", fields: [recordedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  crewAssignment CrewTripAssignment? @relation(fields: [crewAssignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  crewDevice     CrewDevice?         @relation(fields: [crewDeviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tripId, clientEventId])
  @@index([tripId, routeWaypointId, recordedAt, id])
  @@index([routeWaypointId])
  @@index([recordedByIdentityId])
  @@index([crewAssignmentId])
  @@index([crewDeviceId])
  @@map("border_event")
}

/// PR-21: one operational incident tied to a concrete trip. Initial facts are
/// immutable; status and owner changes are controlled by PostgreSQL. Evolving
/// information is kept as append-only IncidentAction rows.
model Incident {
  id                 String           @id @default(uuid(7)) @db.Uuid
  /// Public, opaque reference: ETI- + 12 CSPRNG Crockford characters.
  reference          String           @unique @db.VarChar(16)
  tripId             String           @map("trip_id") @db.Uuid
  vehicleId          String?          @map("vehicle_id") @db.Uuid
  routeWaypointId    String?          @map("route_waypoint_id") @db.Uuid
  baggageId          String?          @map("baggage_id") @db.Uuid
  type               IncidentType
  severity           IncidentSeverity
  status             IncidentStatus   @default(OPEN)
  source             IncidentSource
  description        String           @db.VarChar(2000)
  locationLabel      String?          @map("location_label") @db.VarChar(160)
  openedAt           DateTime         @map("opened_at") @db.Timestamptz(3)
  recordedAt         DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(3)
  resolvedAt         DateTime?        @map("resolved_at") @db.Timestamptz(3)
  closedAt           DateTime?        @map("closed_at") @db.Timestamptz(3)
  openedByIdentityId String           @map("opened_by_identity_id") @db.Uuid
  ownerIdentityId    String?          @map("owner_identity_id") @db.Uuid
  clientEventId      String           @map("client_event_id") @db.VarChar(64)
  payloadFingerprint String           @map("payload_fingerprint") @db.Char(64)
  crewAssignmentId   String?          @map("crew_assignment_id") @db.Uuid
  crewDeviceId       String?          @map("crew_device_id") @db.Uuid

  trip           Trip                 @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  vehicle        Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  routeWaypoint  RouteWaypoint?       @relation(fields: [routeWaypointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  baggage        Baggage?             @relation(fields: [baggageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  openedBy       AuthIdentity         @relation("IncidentOpener", fields: [openedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner          AuthIdentity?        @relation("IncidentOwner", fields: [ownerIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  crewAssignment CrewTripAssignment?  @relation(fields: [crewAssignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  crewDevice     CrewDevice?          @relation(fields: [crewDeviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actions        IncidentAction[]
  attachments    IncidentAttachment[]

  @@unique([tripId, clientEventId])
  @@index([status, severity, recordedAt, id])
  @@index([tripId, recordedAt, id])
  @@index([vehicleId, status])
  @@index([routeWaypointId])
  @@index([baggageId])
  @@index([ownerIdentityId, status])
  @@index([crewAssignmentId])
  @@index([crewDeviceId])
  @@map("incident")
}

/// Append-only operational action journal. Status transitions remain on
/// Incident so querying the current queue never requires folding the journal.
model IncidentAction {
  id                  String             @id @default(uuid(7)) @db.Uuid
  incidentId          String             @map("incident_id") @db.Uuid
  sequence            Int
  type                IncidentActionType
  content             String             @db.VarChar(2000)
  clientActionId      String             @map("client_action_id") @db.VarChar(64)
  payloadFingerprint  String             @map("payload_fingerprint") @db.Char(64)
  createdByIdentityId String             @map("created_by_identity_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  incident  Incident     @relation(fields: [incidentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy AuthIdentity @relation("IncidentActionActor", fields: [createdByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([incidentId, sequence])
  @@unique([incidentId, clientActionId])
  @@index([incidentId, createdAt, id])
  @@index([createdByIdentityId, createdAt])
  @@map("incident_action")
}

/// Private operational evidence. Bytes stay in the existing private object
/// store; PostgreSQL holds only integrity metadata and authorization links.
model IncidentAttachment {
  id                   String   @id @default(uuid(7)) @db.Uuid
  incidentId           String   @map("incident_id") @db.Uuid
  objectKey            String   @unique @map("object_key") @db.VarChar(96)
  sha256               String   @db.Char(64)
  mimeType             String   @map("mime_type") @db.VarChar(64)
  sizeBytes            Int      @map("size_bytes")
  uploadedByIdentityId String   @map("uploaded_by_identity_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  incident   Incident     @relation(fields: [incidentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy AuthIdentity @relation("IncidentAttachmentUploader", fields: [uploadedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([incidentId, createdAt, id])
  @@index([uploadedByIdentityId, createdAt])
  @@map("incident_attachment")
}

/// PR-22: additional trip revenue. Ticket revenue is never duplicated here:
/// it is derived from existing SUCCEEDED Payment rows.
model TripRevenue {
  id                  String             @id @default(uuid(7)) @db.Uuid
  reference           String             @unique @db.VarChar(17)
  tripId              String             @map("trip_id") @db.Uuid
  baggageId           String?            @map("baggage_id") @db.Uuid
  type                FinanceRevenueType
  status              FinanceEntryStatus @default(ACTIVE)
  amountMinor         BigInt             @map("amount_minor")
  currencyCode        String             @map("currency_code") @db.VarChar(3)
  currencyMinorUnit   Int                @map("currency_minor_unit")
  description         String             @db.VarChar(500)
  occurredAt          DateTime           @map("occurred_at") @db.Timestamptz(3)
  createdByIdentityId String             @map("created_by_identity_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedByIdentityId  String?            @map("voided_by_identity_id") @db.Uuid
  voidedAt            DateTime?          @map("voided_at") @db.Timestamptz(3)
  voidReason          String?            @map("void_reason") @db.VarChar(500)

  trip      Trip          @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  baggage   Baggage?      @relation(fields: [baggageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy AuthIdentity  @relation("TripRevenueCreator", fields: [createdByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  voidedBy  AuthIdentity? @relation("TripRevenueVoider", fields: [voidedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tripId, status, occurredAt, id])
  @@index([baggageId])
  @@index([createdByIdentityId, createdAt])
  @@map("trip_revenue")
}

model TripExpense {
  id                  String             @id @default(uuid(7)) @db.Uuid
  reference           String             @unique @db.VarChar(17)
  tripId              String             @map("trip_id") @db.Uuid
  type                FinanceExpenseType
  status              FinanceEntryStatus @default(ACTIVE)
  amountMinor         BigInt             @map("amount_minor")
  currencyCode        String             @map("currency_code") @db.VarChar(3)
  currencyMinorUnit   Int                @map("currency_minor_unit")
  description         String             @db.VarChar(500)
  vendorLabel         String?            @map("vendor_label") @db.VarChar(160)
  occurredAt          DateTime           @map("occurred_at") @db.Timestamptz(3)
  createdByIdentityId String             @map("created_by_identity_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedByIdentityId  String?            @map("voided_by_identity_id") @db.Uuid
  voidedAt            DateTime?          @map("voided_at") @db.Timestamptz(3)
  voidReason          String?            @map("void_reason") @db.VarChar(500)

  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy AuthIdentity     @relation("TripExpenseCreator", fields: [createdByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  voidedBy  AuthIdentity?    @relation("TripExpenseVoider", fields: [voidedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payouts   Payout[]
  receipts  FinanceReceipt[]

  @@index([tripId, status, occurredAt, id])
  @@index([createdByIdentityId, createdAt])
  @@map("trip_expense")
}

model Refund {
  id                   String   @id @default(uuid(7)) @db.Uuid
  reference            String   @unique @db.VarChar(17)
  paymentId            String   @map("payment_id") @db.Uuid
  clientRefundId       String   @map("client_refund_id") @db.VarChar(64)
  amountMinor          BigInt   @map("amount_minor")
  currencyCode         String   @map("currency_code") @db.VarChar(3)
  currencyMinorUnit    Int      @map("currency_minor_unit")
  reason               String   @db.VarChar(500)
  recordedByIdentityId String   @map("recorded_by_identity_id") @db.Uuid
  recordedAt           DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  payment    Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy AuthIdentity @relation("RefundRecorder", fields: [recordedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creditNote CreditNote?

  @@unique([paymentId, clientRefundId])
  @@index([paymentId, recordedAt, id])
  @@index([recordedByIdentityId, recordedAt])
  @@map("refund")
}

model CreditNote {
  id                 String   @id @default(uuid(7)) @db.Uuid
  reference          String   @unique @db.VarChar(17)
  refundId           String   @unique @map("refund_id") @db.Uuid
  amountMinor        BigInt   @map("amount_minor")
  currencyCode       String   @map("currency_code") @db.VarChar(3)
  currencyMinorUnit  Int      @map("currency_minor_unit")
  issuedByIdentityId String   @map("issued_by_identity_id") @db.Uuid
  issuedAt           DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  refund   Refund       @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuedBy AuthIdentity @relation("CreditNoteIssuer", fields: [issuedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([issuedByIdentityId, issuedAt])
  @@map("credit_note")
}

model Payout {
  id                   String   @id @default(uuid(7)) @db.Uuid
  reference            String   @unique @db.VarChar(17)
  expenseId            String   @map("expense_id") @db.Uuid
  clientPayoutId       String   @map("client_payout_id") @db.VarChar(64)
  amountMinor          BigInt   @map("amount_minor")
  currencyCode         String   @map("currency_code") @db.VarChar(3)
  currencyMinorUnit    Int      @map("currency_minor_unit")
  note                 String?  @db.VarChar(500)
  recordedByIdentityId String   @map("recorded_by_identity_id") @db.Uuid
  paidAt               DateTime @map("paid_at") @db.Timestamptz(3)
  recordedAt           DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  expense    TripExpense  @relation(fields: [expenseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy AuthIdentity @relation("PayoutRecorder", fields: [recordedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([expenseId, clientPayoutId])
  @@index([expenseId, paidAt, id])
  @@index([recordedByIdentityId, recordedAt])
  @@map("payout")
}

model FinanceReceipt {
  id                   String   @id @default(uuid(7)) @db.Uuid
  reference            String   @unique @db.VarChar(17)
  expenseId            String   @map("expense_id") @db.Uuid
  objectKey            String   @unique @map("object_key") @db.VarChar(96)
  sha256               String   @db.Char(64)
  mimeType             String   @map("mime_type") @db.VarChar(64)
  sizeBytes            Int      @map("size_bytes")
  uploadedByIdentityId String   @map("uploaded_by_identity_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  expense    TripExpense  @relation(fields: [expenseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy AuthIdentity @relation("FinanceReceiptUploader", fields: [uploadedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([expenseId, createdAt, id])
  @@index([uploadedByIdentityId, createdAt])
  @@map("finance_receipt")
}

model CrewDevice {
  id                  String    @id @default(uuid(7)) @db.Uuid
  /// Public random identifier generated by the PWA. Context only, never authentication.
  deviceId            String    @unique @map("device_id") @db.VarChar(64)
  identityId          String    @map("identity_id") @db.Uuid
  label               String?   @db.VarChar(80)
  enrolledAt          DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt          DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByIdentityId String?   @map("revoked_by_identity_id") @db.Uuid
  revocationReason    String?   @map("revocation_reason") @db.VarChar(255)

  identity             AuthIdentity          @relation("CrewDeviceOwner", fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy            AuthIdentity?         @relation("CrewDeviceRevoker", fields: [revokedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  boardings            PassengerBoarding[]
  trackingObservations TrackingObservation[]
  borderEvents         BorderEvent[]
  incidentReports      Incident[]

  @@index([identityId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("crew_device")
}

model CrewTripAssignment {
  id                   String    @id @default(uuid(7)) @db.Uuid
  tripId               String    @map("trip_id") @db.Uuid
  crewIdentityId       String    @map("crew_identity_id") @db.Uuid
  assignedByIdentityId String    @map("assigned_by_identity_id") @db.Uuid
  assignedAt           DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  expiresAt            DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByIdentityId  String?   @map("revoked_by_identity_id") @db.Uuid
  revocationReason     String?   @map("revocation_reason") @db.VarChar(255)

  trip                 Trip                  @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  crew                 AuthIdentity          @relation("CrewTripAssignmentCrew", fields: [crewIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedBy           AuthIdentity          @relation("CrewTripAssignmentGrantor", fields: [assignedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy            AuthIdentity?         @relation("CrewTripAssignmentRevoker", fields: [revokedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  boardings            PassengerBoarding[]
  trackingObservations TrackingObservation[]
  borderEvents         BorderEvent[]
  incidentReports      Incident[]

  @@index([tripId, revokedAt])
  @@index([crewIdentityId, revokedAt, expiresAt])
  @@index([assignedByIdentityId])
  @@index([revokedByIdentityId])
  @@map("crew_trip_assignment")
}

model PassengerBoarding {
  id                   String   @id @default(uuid(7)) @db.Uuid
  /// Public, immutable reference: ETE- + 12 CSPRNG Crockford base32 characters.
  reference            String   @unique @db.VarChar(16)
  checkInId            String   @unique @map("check_in_id") @db.Uuid
  /// Bounded operational metadata (PR-18 owns device enrollment): no identity proof.
  deviceId             String   @map("device_id") @db.VarChar(64)
  clientEventId        String?  @map("client_event_id") @db.VarChar(64)
  payloadFingerprint   String   @map("payload_fingerprint") @db.Char(64)
  /// Readiness recomputed at boarding (may differ from the check-in one).
  readinessFingerprint String   @map("readiness_fingerprint") @db.Char(64)
  /// Operator-reported time, bounded by the trigger.
  occurredAt           DateTime @map("occurred_at") @db.Timestamptz(3)
  /// Server clock, set by the trigger.
  boardedAt            DateTime @default(now()) @map("boarded_at") @db.Timestamptz(3)
  boardedByIdentityId  String   @map("boarded_by_identity_id") @db.Uuid
  /// PR-18 provenance. Null for legacy/STAFF boarding; required together for CREW boarding.
  crewDeviceId         String?  @map("crew_device_id") @db.Uuid
  crewAssignmentId     String?  @map("crew_assignment_id") @db.Uuid

  checkIn        PassengerCheckIn    @relation(fields: [checkInId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  boardedBy      AuthIdentity        @relation("PassengerBoardingActor", fields: [boardedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  crewDevice     CrewDevice?         @relation(fields: [crewDeviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  crewAssignment CrewTripAssignment? @relation(fields: [crewAssignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([deviceId, clientEventId])
  @@index([boardedAt, id])
  @@index([boardedByIdentityId])
  @@index([crewDeviceId])
  @@index([crewAssignmentId])
  @@map("passenger_boarding")
}

/// PR-15: one immutable, versioned passenger snapshot for a scheduled trip.
/// It contains only checked-in passengers and intentionally carries no
/// readiness, authorization, document, payment, compliance or QR secrets.
model PassengerManifest {
  id                    String   @id @default(uuid(7)) @db.Uuid
  /// Public, immutable reference: ETM- + 12 CSPRNG Crockford base32 characters.
  reference             String   @unique @db.VarChar(16)
  tripId                String   @map("trip_id") @db.Uuid
  version               Int
  schemaVersion         String   @map("schema_version") @db.VarChar(32)
  contentHash           String   @map("content_hash") @db.Char(64)
  passengerCount        Int      @map("passenger_count")
  boardedCount          Int      @map("boarded_count")
  snapshot              Json     @db.JsonB
  generatedByIdentityId String   @map("generated_by_identity_id") @db.Uuid
  /// Authoritative database clock, overwritten by the insertion guard.
  generatedAt           DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  generatedBy AuthIdentity @relation("PassengerManifestGenerator", fields: [generatedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tripId, version])
  @@index([generatedAt, id])
  @@index([generatedByIdentityId])
  @@map("passenger_manifest")
}

/// PR-16: a data-driven operational regulatory permit. It proves only its
/// own intrinsic validity; PR-17 owns trip readiness and dispatch.
model RegulatoryPermit {
  id                    String                    @id @default(uuid(7)) @db.Uuid
  /// ETRP avoids the existing ETP payment-reference namespace.
  reference             String                    @unique @db.VarChar(17)
  permitType            String                    @map("permit_type") @db.VarChar(64)
  title                 String                    @db.VarChar(160)
  issuingAuthority      String                    @map("issuing_authority") @db.VarChar(200)
  authorityReference    String?                   @map("authority_reference") @db.VarChar(200)
  jurisdictionCountryId String?                   @map("jurisdiction_country_id") @db.Uuid
  validFrom             DateTime                  @map("valid_from") @db.Date
  validUntil            DateTime                  @map("valid_until") @db.Date
  status                RegulatoryPermitStatus    @default(DRAFT)
  scopeType             RegulatoryPermitScopeType @map("scope_type")
  scopeCountryId        String?                   @map("scope_country_id") @db.Uuid
  vehicleId             String?                   @map("vehicle_id") @db.Uuid
  routeVersionId        String?                   @map("route_version_id") @db.Uuid
  tripId                String?                   @map("trip_id") @db.Uuid
  sourceUrl             String?                   @map("source_url") @db.VarChar(500)
  sourceCheckedOn       DateTime?                 @map("source_checked_on") @db.Date
  notes                 String?                   @db.VarChar(1000)
  revision              Int                       @default(1)
  createdByIdentityId   String                    @map("created_by_identity_id") @db.Uuid
  updatedByIdentityId   String                    @map("updated_by_identity_id") @db.Uuid
  activatedAt           DateTime?                 @map("activated_at") @db.Timestamptz(3)
  activatedByIdentityId String?                   @map("activated_by_identity_id") @db.Uuid
  revokedAt             DateTime?                 @map("revoked_at") @db.Timestamptz(3)
  revokedByIdentityId   String?                   @map("revoked_by_identity_id") @db.Uuid
  revocationReason      String?                   @map("revocation_reason") @db.VarChar(500)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  jurisdictionCountry Country?      @relation("RegulatoryPermitJurisdiction", fields: [jurisdictionCountryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scopeCountry        Country?      @relation("RegulatoryPermitCountryScope", fields: [scopeCountryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  vehicle             Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  routeVersion        RouteVersion? @relation(fields: [routeVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  trip                Trip?         @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy           AuthIdentity  @relation("RegulatoryPermitCreator", fields: [createdByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy           AuthIdentity  @relation("RegulatoryPermitUpdater", fields: [updatedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activatedBy         AuthIdentity? @relation("RegulatoryPermitActivator", fields: [activatedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy           AuthIdentity? @relation("RegulatoryPermitRevoker", fields: [revokedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, id])
  @@index([permitType, id])
  @@index([jurisdictionCountryId, id])
  @@index([scopeCountryId, status, id])
  @@index([vehicleId, status, id])
  @@index([routeVersionId, status, id])
  @@index([tripId, status, id])
  @@index([createdByIdentityId])
  @@index([updatedByIdentityId])
  @@index([activatedByIdentityId])
  @@index([revokedByIdentityId])
  @@map("regulatory_permit")
}

/// PR-17: one immutable published permit-requirement policy version for one
/// trip. The service constructs DRAFT + requirements + PUBLISHED atomically;
/// a published empty version explicitly means “no operational permits required”.
model DeparturePermitPolicy {
  id                    String                      @id @default(uuid(7)) @db.Uuid
  tripId                String                      @map("trip_id") @db.Uuid
  version               Int
  status                DeparturePermitPolicyStatus @default(DRAFT)
  schemaVersion         String                      @map("schema_version") @db.VarChar(40)
  contentHash           String?                     @map("content_hash") @db.Char(64)
  requirementCount      Int?                        @map("requirement_count")
  publishedByIdentityId String?                     @map("published_by_identity_id") @db.Uuid
  publishedAt           DateTime?                   @map("published_at") @db.Timestamptz(3)
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)

  trip         Trip                         @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publishedBy  AuthIdentity?                @relation("DeparturePermitPolicyPublisher", fields: [publishedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requirements DeparturePermitRequirement[]

  @@unique([tripId, version])
  @@index([publishedAt, id])
  @@index([publishedByIdentityId])
  @@map("departure_permit_policy")
}

/// One explicit generic requirement within a policy. OPERATOR, VEHICLE,
/// ROUTE_VERSION and TRIP resolve against the policy trip; COUNTRY points to
/// one concrete Country row. No hierarchy or legal inference exists here.
model DeparturePermitRequirement {
  policyId       String                    @map("policy_id") @db.Uuid
  sequence       Int
  permitType     String                    @map("permit_type") @db.VarChar(64)
  scopeType      RegulatoryPermitScopeType @map("scope_type")
  scopeCountryId String?                   @map("scope_country_id") @db.Uuid

  policy       DeparturePermitPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scopeCountry Country?              @relation(fields: [scopeCountryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([policyId, sequence])
  @@index([permitType, scopeType])
  @@index([scopeCountryId])
  @@map("departure_permit_requirement")
}

/// PR-17: immutable proof that an authorized STAFF identity explicitly
/// approved one currently-ready trip. Facts are minimized and fingerprinted;
/// a later facts change requires a newer authorization before departure.
model DepartureAuthorization {
  id                     String   @id @default(uuid(7)) @db.Uuid
  reference              String   @unique @db.VarChar(17)
  tripId                 String   @map("trip_id") @db.Uuid
  version                Int
  engineVersion          String   @map("engine_version") @db.VarChar(40)
  readinessFingerprint   String   @map("readiness_fingerprint") @db.Char(64)
  readinessSnapshot      Json     @map("readiness_snapshot") @db.JsonB
  authorizedByIdentityId String   @map("authorized_by_identity_id") @db.Uuid
  authorizedAt           DateTime @default(now()) @map("authorized_at") @db.Timestamptz(3)

  trip         Trip         @relation("TripDepartureAuthorizations", fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  authorizedBy AuthIdentity @relation("DepartureAuthorizationActor", fields: [authorizedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  usedByTrip   Trip?        @relation("TripUsedDepartureAuthorization")

  @@unique([tripId, version])
  @@index([authorizedAt, id])
  @@index([authorizedByIdentityId])
  @@map("departure_authorization")
}

/// CMS-1: one public page, the site settings or the navigation. Never deleted:
/// a page is archived (no longer served). Kind and key are immutable.
model ContentEntry {
  id           String           @id @default(uuid(7)) @db.Uuid
  kind         ContentEntryKind
  /// PAGE: its public path (e.g. "/paris-dakar"); singletons: "site", "navigation".
  key          String           @db.VarChar(120)
  /// Highest revision number ever issued: numbers are never reused, even
  /// when a draft is discarded (maintained by the revision trigger).
  lastRevision Int              @default(0) @map("last_revision")
  archivedAt   DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  revisions ContentRevision[]

  @@unique([kind, key])
  @@map("content_entry")
}

/// CMS-1: one numbered revision of an entry's structured document. At most
/// one DRAFT and one PUBLISHED per entry (partial unique indexes). PUBLISHED
/// and SUPERSEDED revisions are immutable (trigger); history is never lost.
model ContentRevision {
  id                    String                @id @default(uuid(7)) @db.Uuid
  entryId               String                @map("entry_id") @db.Uuid
  revision              Int
  status                ContentRevisionStatus @default(DRAFT)
  /// Structured document validated by @euroteranga/content (no HTML).
  document              Json
  /// Optional editor note shown in the history.
  note                  String?               @db.VarChar(200)
  /// Revision this one was started from (edit of the live one, or a restore).
  basedOnRevision       Int?                  @map("based_on_revision")
  /// Null for system actors (content bootstrap).
  authorIdentityId      String?               @map("author_identity_id") @db.Uuid
  publishedAt           DateTime?             @map("published_at") @db.Timestamptz(3)
  publishedByIdentityId String?               @map("published_by_identity_id") @db.Uuid
  supersededAt          DateTime?             @map("superseded_at") @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  entry       ContentEntry  @relation(fields: [entryId], references: [id], onDelete: Restrict)
  author      AuthIdentity? @relation("ContentRevisionAuthor", fields: [authorIdentityId], references: [id], onDelete: Restrict)
  publishedBy AuthIdentity? @relation("ContentRevisionPublisher", fields: [publishedByIdentityId], references: [id], onDelete: Restrict)

  @@unique([entryId, revision])
  @@index([entryId, status])
  @@index([authorIdentityId])
  @@index([publishedByIdentityId])
  @@map("content_revision")
}

/// MEDIA-1: an image of the public website media library. It is separate
/// from passenger documents (private storage, never public). The uploaded
/// file itself is never kept: only WebP renditions re-encoded without
/// metadata (EXIF, GPS, ICC comments) are stored and served.
model PublicMediaAsset {
  id                   String            @id @default(uuid(7)) @db.Uuid
  status               PublicMediaStatus @default(ACTIVE)
  /// Alternative text read by screen readers (required, never empty).
  altText              String            @map("alt_text") @db.VarChar(250)
  caption              String?           @db.VarChar(240)
  /// Author or rights holder, shown with the image when set.
  credit               String?           @db.VarChar(160)
  /// jpeg, png or webp: the format the upload was decoded from.
  sourceFormat         String            @map("source_format") @db.VarChar(8)
  /// SHA-256 of the uploaded bytes. Unique among active assets (partial
  /// index in SQL): an archived file can be uploaded again as a new asset.
  sourceSha256         String            @map("source_sha256") @db.Char(64)
  sourceBytes          Int               @map("source_bytes")
  /// Dimensions once the EXIF orientation is applied.
  width                Int
  height               Int
  /// Point kept visible when the image is cropped, in percent (0-100).
  focalX               Int               @default(50) @map("focal_x") @db.SmallInt
  focalY               Int               @default(50) @map("focal_y") @db.SmallInt
  /// Null only for system actors.
  createdByIdentityId  String?           @map("created_by_identity_id") @db.Uuid
  updatedByIdentityId  String?           @map("updated_by_identity_id") @db.Uuid
  archivedAt           DateTime?         @map("archived_at") @db.Timestamptz(3)
  archivedByIdentityId String?           @map("archived_by_identity_id") @db.Uuid
  archiveReason        String?           @map("archive_reason") @db.VarChar(300)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  renditions PublicMediaRendition[]
  createdBy  AuthIdentity?          @relation("PublicMediaCreator", fields: [createdByIdentityId], references: [id], onDelete: Restrict)
  updatedBy  AuthIdentity?          @relation("PublicMediaUpdater", fields: [updatedByIdentityId], references: [id], onDelete: Restrict)
  archivedBy AuthIdentity?          @relation("PublicMediaArchiver", fields: [archivedByIdentityId], references: [id], onDelete: Restrict)
  primaryForVehicles Vehicle[]      @relation("VehiclePrimaryMedia")
  vehicleGallery     VehicleMedia[] @relation("VehicleGalleryMedia")

  @@index([status, createdAt])
  @@index([sourceSha256])
  @@index([createdByIdentityId])
  @@index([updatedByIdentityId])
  @@index([archivedByIdentityId])
  @@map("public_media_asset")
}

/// MEDIA-1: one immutable WebP rendition of a media asset, stored under a
/// content-addressed key (`public-media/<xx>/<sha256>`).
model PublicMediaRendition {
  id         String   @id @default(uuid(7)) @db.Uuid
  assetId    String   @map("asset_id") @db.Uuid
  width      Int
  height     Int
  format     String   @db.VarChar(8)
  bytes      Int
  sha256     String   @db.Char(64)
  /// Content-addressed: the same bytes uploaded again share the file.
  storageKey String   @map("storage_key") @db.VarChar(120)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  asset PublicMediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([assetId, width])
  @@index([storageKey])
  @@map("public_media_rendition")
}
