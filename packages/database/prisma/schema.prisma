// EURO TERANGA — database schema.
//
// Business tables are introduced by the pull requests that own each domain.
// PR-02 adds authentication only: identities able to authenticate, their
// credentials, sessions and single-use tokens. No role or permission exists
// yet (PR-03). Tables and columns use snake_case; all timestamps are
// timestamptz (UTC). The connection URL comes from prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Authentication realm. Not a business role: STAFF is not yet DIRECTOR etc.
enum AuthRealm {
  CUSTOMER
  STAFF
  CREW

  @@map("auth_realm")
}

enum AuthIdentityStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("auth_identity_status")
}

enum AuthChallengeType {
  MFA_LOGIN
  MFA_ENROLLMENT

  @@map("auth_challenge_type")
}

enum AuthSessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET
  ADMIN_ACTION

  @@map("auth_session_revocation_reason")
}

/// An identity able to authenticate in exactly one realm. It is not a
/// customer, passenger, staff profile or crew member: those business objects
/// will reference it later and stay independent.
model AuthIdentity {
  id              String             @id @default(uuid(7)) @db.Uuid
  realm           AuthRealm
  /// Address as entered (display only).
  email           String             @db.VarChar(254)
  /// trim + lowercase; used for lookup and uniqueness (docs/security/authentication.md).
  normalizedEmail String             @map("normalized_email") @db.VarChar(254)
  status          AuthIdentityStatus
  emailVerifiedAt DateTime?          @map("email_verified_at") @db.Timestamptz(3)
  /// Incremented to invalidate every session at once (password change/reset...).
  authVersion     Int                @default(1) @map("auth_version")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordCredential      PasswordCredential?
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  challenges              AuthChallenge[]
  mfaTotpCredential       MfaTotpCredential?
  mfaRecoveryCodes        MfaRecoveryCode[]

  roleAssignments         AuthorizationRoleAssignment[] @relation("RoleAssignmentIdentity")
  roleGrantsIssued        AuthorizationRoleAssignment[] @relation("RoleAssignmentGrantedBy")
  roleRevocationsIssued   AuthorizationRoleAssignment[] @relation("RoleAssignmentRevokedBy")
  auditEvents             AuditEvent[]                  @relation("AuditActor")
  staffInvitations        StaffInvitation[]             @relation("StaffInvitationIdentity")
  staffInvitationsCreated StaffInvitation[]             @relation("StaffInvitationCreatedBy")
  staffEnrollmentGrant    StaffEnrollmentGrant?         @relation("StaffEnrollmentIdentity")
  staffEnrollmentGrantsIssued StaffEnrollmentGrant[]    @relation("StaffEnrollmentIssuedBy")

  // The same address may exist in two realms as two unrelated identities.
  @@unique([realm, normalizedEmail])
  @@map("auth_identity")
}

model PasswordCredential {
  identityId   String   @id @map("identity_id") @db.Uuid
  /// PHC-encoded Argon2id hash (algorithm and parameters included).
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("password_credential")
}

/// Opaque, revocable browser session. Only SHA-256(token) is stored.
model AuthSession {
  id                String                       @id @default(uuid(7)) @db.Uuid
  identityId        String                       @map("identity_id") @db.Uuid
  tokenHash         Bytes                        @unique @map("token_hash")
  /// Copy of AuthIdentity.authVersion at creation; a mismatch invalidates the session.
  authVersion       Int                          @map("auth_version")
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime                     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime                     @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime                     @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?                    @map("revoked_at") @db.Timestamptz(3)
  revocationReason  AuthSessionRevocationReason? @map("revocation_reason")

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([absoluteExpiresAt])
  @@map("auth_session")
}

/// Single-use email verification token (hash only). It carries the password
/// hash chosen at registration, applied only when the token is verified.
model EmailVerificationToken {
  id                  String    @id @default(uuid(7)) @db.Uuid
  identityId          String    @map("identity_id") @db.Uuid
  tokenHash           Bytes     @unique @map("token_hash")
  pendingPasswordHash String?   @map("pending_password_hash")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt       DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
  @@map("email_verification_token")
}

/// Single-use password reset token (hash only).
model PasswordResetToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  identityId    String    @map("identity_id") @db.Uuid
  tokenHash     Bytes     @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

/// Short-lived, attempt-limited step between password and second factor.
model AuthChallenge {
  id         String            @id @default(uuid(7)) @db.Uuid
  identityId String            @map("identity_id") @db.Uuid
  type       AuthChallengeType
  tokenHash  Bytes             @unique @map("token_hash")
  attempts   Int               @default(0)
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?         @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
  @@map("auth_challenge")
}

/// TOTP secret, encrypted with AES-256-GCM (key outside the database).
/// enabledAt is null while enrollment is pending.
model MfaTotpCredential {
  identityId       String    @id @map("identity_id") @db.Uuid
  /// Ciphertext followed by the 16-byte GCM authentication tag.
  secretCiphertext Bytes     @map("secret_ciphertext")
  secretNonce      Bytes     @map("secret_nonce")
  keyVersion       Int       @map("key_version")
  enabledAt        DateTime? @map("enabled_at") @db.Timestamptz(3)
  /// Highest accepted 30-second time step; codes at or below it are replays.
  lastAcceptedStep BigInt?   @map("last_accepted_step")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("mfa_totp_credential")
}

/// Single-use recovery code (SHA-256 of a high-entropy code; shown once).
model MfaRecoveryCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  identityId String    @map("identity_id") @db.Uuid
  codeHash   Bytes     @unique @map("code_hash")
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("mfa_recovery_code")
}

/// Fixed-window rate-limit counter. The key is an HMAC of the action and of
/// the limited signal (IP, identity hint): no raw email or IP is stored.
model AuthRateLimitBucket {
  key         Bytes
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  action      String   @db.VarChar(64)
  count       Int
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("auth_rate_limit_bucket")
}


/// Atomic permission enforced by the API. Permissions are seeded by migration
/// and referenced by stable machine keys, never by display labels.
model AuthorizationPermission {
  key         String   @id @db.VarChar(96)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles AuthorizationRolePermission[]

  @@map("authorization_permission")
}

/// Named collection of permissions. System roles are seeded and immutable
/// through PR-03 APIs; later custom-role support can build on this model.
model AuthorizationRole {
  key         String   @id @db.VarChar(64)
  name        String   @db.VarChar(96)
  description String   @db.VarChar(255)
  system      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions AuthorizationRolePermission[]
  assignments AuthorizationRoleAssignment[]

  @@map("authorization_role")
}

model AuthorizationRolePermission {
  roleKey       String @map("role_key") @db.VarChar(64)
  permissionKey String @map("permission_key") @db.VarChar(96)

  role       AuthorizationRole       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission AuthorizationPermission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@map("authorization_role_permission")
}

/// Revocable role grant. Historical grants are never overwritten or deleted:
/// revocation timestamps close the grant and preserve who did what.
model AuthorizationRoleAssignment {
  id                  String    @id @default(uuid(7)) @db.Uuid
  identityId          String    @map("identity_id") @db.Uuid
  roleKey             String    @map("role_key") @db.VarChar(64)
  grantedByIdentityId String?   @map("granted_by_identity_id") @db.Uuid
  grantedAt           DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByIdentityId String?   @map("revoked_by_identity_id") @db.Uuid
  reason              String?   @db.VarChar(255)

  identity  AuthIdentity  @relation("RoleAssignmentIdentity", fields: [identityId], references: [id], onDelete: Cascade)
  role      AuthorizationRole @relation(fields: [roleKey], references: [key], onDelete: Restrict)
  grantedBy AuthIdentity? @relation("RoleAssignmentGrantedBy", fields: [grantedByIdentityId], references: [id], onDelete: SetNull)
  revokedBy AuthIdentity? @relation("RoleAssignmentRevokedBy", fields: [revokedByIdentityId], references: [id], onDelete: SetNull)

  @@index([identityId, revokedAt])
  @@index([roleKey, revokedAt])
  @@map("authorization_role_assignment")
}

/// Append-only security/business audit record for privileged actions.
/// Application code has no update/delete operation for this model.
model AuditEvent {
  id              String    @id @default(uuid(7)) @db.Uuid
  occurredAt      DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorIdentityId String?   @map("actor_identity_id") @db.Uuid
  actorRealm      AuthRealm? @map("actor_realm")
  action          String    @db.VarChar(96)
  resourceType    String    @map("resource_type") @db.VarChar(64)
  resourceId      String?   @map("resource_id") @db.VarChar(128)
  sessionId       String?   @map("session_id") @db.Uuid
  requestId       String?   @map("request_id") @db.VarChar(128)
  before          Json?
  after           Json?
  metadata        Json?

  actor AuthIdentity? @relation("AuditActor", fields: [actorIdentityId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([actorIdentityId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@map("audit_event")
}

/// Hash-only, single-use invitation that lets an administrator provision a
/// STAFF identity without exposing a public staff-registration endpoint.
model StaffInvitation {
  id                  String    @id @default(uuid(7)) @db.Uuid
  identityId          String    @map("identity_id") @db.Uuid
  tokenHash           Bytes     @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt       DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdByIdentityId String?   @map("created_by_identity_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  identity  AuthIdentity  @relation("StaffInvitationIdentity", fields: [identityId], references: [id], onDelete: Cascade)
  createdBy AuthIdentity? @relation("StaffInvitationCreatedBy", fields: [createdByIdentityId], references: [id], onDelete: SetNull)

  @@index([identityId])
  @@index([expiresAt])
  @@map("staff_invitation")
}

/// Explicit administrator authorization to perform first-time STAFF TOTP
/// enrollment. Password knowledge alone is not enough to enroll MFA.
model StaffEnrollmentGrant {
  identityId          String    @id @map("identity_id") @db.Uuid
  issuedByIdentityId  String?   @map("issued_by_identity_id") @db.Uuid
  issuedAt            DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(3)

  identity AuthIdentity  @relation("StaffEnrollmentIdentity", fields: [identityId], references: [id], onDelete: Cascade)
  issuedBy AuthIdentity? @relation("StaffEnrollmentIssuedBy", fields: [issuedByIdentityId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("staff_enrollment_grant")
}
