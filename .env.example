# EURO TERANGA — example environment for local development.
#
# Copy to `.env` at the repository root and adjust. PLACEHOLDER VALUES ONLY:
# never put a real credential in this file, it is committed and public.
# Every application validates its variables at startup and refuses to start
# when one is missing or invalid.

# --- Core API (apps/api) -----------------------------------------------------
NODE_ENV=development
# One of: local, ci, staging, production
APP_ENV=local
# Documentation placeholder matching infrastructure/dev/docker-compose.yml.
# It is not a real credential.
DATABASE_URL=postgresql://euroteranga:change-me@localhost:5432/euroteranga_dev
API_HOST=127.0.0.1
API_PORT=4000
# Exact origins, comma-separated. "*" is rejected.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
# Serves interactive API docs at /docs. Keep false outside local development.
OPENAPI_ENABLED=true
# One of: debug, info, warn, error
LOG_LEVEL=info

# --- Frontends (apps/web, booking, client, tracking, ops, crew) --------------
# NEXT_PUBLIC_* values are embedded in browser JavaScript: never put a secret
# here. Builds fail if a sensitive-looking name uses this prefix.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Local PostgreSQL container (infrastructure/dev/docker-compose.yml) ------
EUROTERANGA_DEV_DB_PORT=5432
