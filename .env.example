# EURO TERANGA — example environment for local development.
#
# Copy to `.env` at the repository root and adjust. PLACEHOLDER VALUES ONLY:
# never put a real credential in this file, it is committed and public.
# Every application validates its variables at startup and refuses to start
# when one is missing or invalid.

# --- Core API (apps/api) -----------------------------------------------------
NODE_ENV=development
# One of: local, ci, staging, production
APP_ENV=local
# Documentation placeholder matching infrastructure/dev/docker-compose.yml.
# It is not a real credential.
DATABASE_URL=postgresql://euroteranga:change-me@localhost:5432/euroteranga_dev
API_HOST=127.0.0.1
API_PORT=4000
# Exact origins, comma-separated. "*" is rejected.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
# Serves interactive API docs at /docs. Keep false outside local development.
OPENAPI_ENABLED=true
# One of: debug, info, warn, error
LOG_LEVEL=info
# Proxies allowed to set X-Forwarded-For: none (default) or loopback.
API_TRUST_PROXY=none

# --- Authentication (apps/api) -----------------------------------------------
# DEVELOPMENT-ONLY example keys (base64). They are public, therefore refused
# at startup when APP_ENV is staging or production. Generate real keys with:
#   openssl rand -base64 32
AUTH_CSRF_KEY=ZGV2LW9ubHktY3NyZi1rZXktbm90LWEtcmVhbC1zZWNyZXQ=
AUTH_HMAC_KEY=ZGV2LW9ubHktaG1hYy1rZXktbm90LWEtcmVhbC1zZWNyZXQ=
# Exactly 32 bytes (AES-256-GCM). Increment the version when rotating.
AUTH_TOTP_ENCRYPTION_KEY=ZGV2LW9ubHktdG90cC1rZXktbm90LWEtc2VjcmV0ISE=
AUTH_TOTP_ENCRYPTION_KEY_VERSION=1

# Browser origins allowed per realm (exact origins, comma-separated).
AUTH_CUSTOMER_ORIGINS=http://localhost:3002
AUTH_STAFF_ORIGINS=http://localhost:3004
AUTH_CREW_ORIGINS=http://localhost:3005

# Session lifetimes in seconds (defaults shown).
AUTH_CUSTOMER_SESSION_ABSOLUTE_SECONDS=2592000
AUTH_CUSTOMER_SESSION_IDLE_SECONDS=604800
AUTH_STAFF_SESSION_ABSOLUTE_SECONDS=43200
AUTH_STAFF_SESSION_IDLE_SECONDS=3600
AUTH_CREW_SESSION_ABSOLUTE_SECONDS=604800
AUTH_CREW_SESSION_IDLE_SECONDS=86400

# Single-use token lifetimes in seconds (defaults shown).
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
# STAFF provisioning (PR-03): invitation link and first-MFA-enrollment grant.
AUTH_STAFF_INVITATION_TTL_SECONDS=259200
AUTH_STAFF_ENROLLMENT_GRANT_TTL_SECONDS=86400

# Authentication mail. Locally, Mailpit (infrastructure/dev) catches every
# message at http://localhost:8025. "disabled" drops mail (refused in production).
AUTH_MAIL_PROVIDER=smtp
AUTH_EMAIL_FROM=no-reply@euroteranga.local
CLIENT_PUBLIC_URL=http://localhost:3002
# Operations back-office URL used in staff invitation links (https in production).
OPS_PUBLIC_URL=http://localhost:3004
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER and SMTP_PASSWORD are set together, only when the server needs them.

# --- Frontends (apps/web, booking, client, tracking, ops, crew) --------------
# NEXT_PUBLIC_* values are embedded in browser JavaScript: never put a secret
# here. Builds fail if a sensitive-looking name uses this prefix.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Local PostgreSQL container (infrastructure/dev/docker-compose.yml) ------
EUROTERANGA_DEV_DB_PORT=5432
