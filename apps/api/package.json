{
  "name": "@euroteranga/api",
  "version": "0.0.0",
  "private": true,
  "description": "EURO TERANGA Core API (NestJS)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --exclude 'test/integration/**/upgrade-from-*.int.spec.ts' && vitest run upgrade-from- --maxWorkers=1 --no-file-parallelism",
    "auth:bootstrap-super-admin": "node --enable-source-maps --env-file-if-exists=../../.env dist/cli/bootstrap-super-admin.js",
    "auth:purge-expired": "node --enable-source-maps --env-file-if-exists=../../.env dist/cli/purge-auth-artifacts.js",
    "data:bootstrap-pilot": "node --enable-source-maps --env-file-if-exists=../../.env dist/cli/bootstrap-pilot-data.js",
    "seed:realistic": "node --enable-source-maps --env-file-if-exists=../../.env dist/cli/seed-realistic.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@euroteranga/config": "workspace:*",
    "@euroteranga/content": "workspace:*",
    "@euroteranga/database": "workspace:*",
    "@euroteranga/logger": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@node-rs/argon2": "catalog:",
    "busboy": "catalog:",
    "cookie": "catalog:",
    "helmet": "catalog:",
    "nodemailer": "catalog:",
    "otpauth": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "catalog:",
    "uqr": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@swc/core": "catalog:",
    "@types/busboy": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
