[Unit]
Description=EURO TERANGA crew
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=euroteranga.com_5p804yhows7
Group=psacln
WorkingDirectory=/var/www/vhosts/euroteranga.com/current/apps/crew
EnvironmentFile=/var/www/vhosts/euroteranga.com/.secrets/public.env
Environment=PATH=/opt/plesk/node/24/bin:/usr/local/bin:/usr/bin:/bin
# Node runs Next.js directly (OPS-DEPLOY-2): the pnpm wrapper turned every normal
# stop (SIGTERM to the control group) into exit code 1, ERR_PNPM_RECURSIVE_EXEC_FIRST_FAIL,
# so deployments logged frontends as failed. A real crash still exits non-zero.
ExecStart=/opt/plesk/node/24/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3205
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=256
MemoryMax=768M

[Install]
WantedBy=multi-user.target
