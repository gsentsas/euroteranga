# Documentation only. bootstrap-pilot-env.sh creates real files:
# /var/www/vhosts/euroteranga.com/.secrets/api.env
# /var/www/vhosts/euroteranga.com/.secrets/public.env
NODE_ENV=production
APP_ENV=staging
DATABASE_URL=postgresql://euroteranga_pilot:<generated>@127.0.0.1:5432/euroteranga_pilot
API_HOST=127.0.0.1
API_PORT=3206
API_TRUST_PROXY=loopback
PAYMENT_PROVIDER=DISABLED
# Stripe stays DISABLED on the pilot (deploy-release.sh refuses anything else).
PAYMENT_STRIPE_MODE=DISABLED
# PayPal stays DISABLED on the pilot too, without any PayPal credential.
PAYMENT_PAYPAL_MODE=DISABLED
OBJECT_STORAGE_PROVIDER=DISABLED
MALWARE_SCANNER=DISABLED
# Public media library (MEDIA-1): disabled by default (read-only in OPS). To
# enable it, create the directory outside the releases first; see
# docs/runbooks/public-media-storage.md.
PUBLIC_MEDIA_STORAGE=DISABLED
# PUBLIC_MEDIA_LOCAL_ROOT=/var/www/vhosts/euroteranga.com/media-library
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_API_BASE_URL=https://api.euroteranga.com
NEXT_PUBLIC_CLIENT_URL=https://client.euroteranga.com
# Public website SEO (read by euroteranga-web at runtime; see
# docs/runbooks/seo-indexing.md). Indexing requires production AND true.
# PUBLIC_SITE_URL=https://euroteranga.com
# SEO_INDEXING_ENABLED=false
# Public website server-side reads (WEB-1, optional): loopback API base and
# application link overrides. Defaults: NEXT_PUBLIC_API_BASE_URL and the CMS
# site settings.
# CORE_API_INTERNAL_URL=http://127.0.0.1:3206
