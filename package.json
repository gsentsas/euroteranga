{
  "name": "euroteranga",
  "version": "0.0.0",
  "private": true,
  "description": "EURO TERANGA platform monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --recursive --parallel --filter \"./apps/**\" run dev",
    "build": "pnpm --recursive --filter \"!@euroteranga/browser-tests\" run build",
    "build:packages": "pnpm --recursive --filter \"./packages/**\" run build",
    "build:frontends": "pnpm --recursive --filter \"./apps/**\" --filter \"!@euroteranga/api\" run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --write apps/api/test/integration/tracking/comfort.int.spec.ts apps/client/app/account.css apps/client/components/customer-comfort.tsx apps/ops/components/tracking/comfort-admin.tsx apps/tracking/app/tracking.css apps/tracking/components/public-tracking.tsx && git diff -- apps/api/test/integration/tracking/comfort.int.spec.ts apps/client/app/account.css apps/client/components/customer-comfort.tsx apps/ops/components/tracking/comfort-admin.tsx apps/tracking/app/tracking.css apps/tracking/components/public-tracking.tsx && exit 1",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "pnpm --recursive --if-present run test:unit",
    "test:integration": "pnpm --filter @euroteranga/api run test:integration",
    "test:e2e": "pnpm --filter @euroteranga/browser-tests run test:e2e",
    "pilot:acceptance": "pnpm --filter @euroteranga/browser-tests run test:pilot",
    "db:generate": "pnpm --filter @euroteranga/database run db:generate",
    "db:validate": "pnpm --filter @euroteranga/database run db:validate",
    "db:migrate": "pnpm --filter @euroteranga/database run db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @euroteranga/database run db:migrate:status",
    "check:forbidden-files": "bash scripts/check-forbidden-files.sh",
    "audit:dependencies": "pnpm audit --audit-level high",
    "auth:bootstrap-super-admin": "pnpm --filter @euroteranga/api run auth:bootstrap-super-admin",
    "auth:purge-expired": "pnpm --filter @euroteranga/api run auth:purge-expired",
    "data:bootstrap-pilot": "pnpm --filter @euroteranga/api run data:bootstrap-pilot",
    "seed:realistic": "pnpm --filter @euroteranga/api run seed:realistic"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
